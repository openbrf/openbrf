{
  "name": "@openbrf/example-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Reference Open BRF plugin: the whole install contract in one package.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "openbrf": {
    "apiVersion": 1,
    "id": "occupancy",
    "entry": {
      "server": "./dist/server.cjs",
      "client": "./dist/remoteEntry.js"
    },
    "permissions": [
      "addressBook:read"
    ],
    "personalData": [
      "name",
      "apartment",
      "residency"
    ],
    "processing": {
      "purpose": {
        "sv": "Visa styrelsen hur många lägenheter, boende och medlemmar föreningen har, räknat bland de boende som tillägget kan se. Bara summor för hela föreningen visas, inga namn och ingen uppgift per lägenhet.",
        "en": "Show the board how many apartments, residents and members the association has, counting only the residents the plugin can see. Only totals for the whole association are shown, with no names and nothing per apartment."
      },
      "legalBasis": "legitimateInterest",
      "legitimateInterest": {
        "sv": "Styrelsens behov av en överblick över boendet för att förvalta föreningen.",
        "en": "The board's need for an overview of who lives in the building in order to run the association."
      },
      "retention": {
        "sv": "Summorna sparas inte: de läses ur registret varje gång vyn visas. De dagar en boende anger att hen är bortrest sparas till 30 dagar efter den sista av dem.",
        "en": "The totals are not kept: they are read from the register each time the view is shown. The days a resident says they are away are kept until 30 days after the last of them."
      },
      "dataSubjects": [
        "members",
        "residents"
      ]
    },
    "personRecords": [
      {
        "collection": "away",
        "titleKey": "records.away.title",
        "personalData": [
          "residency"
        ],
        "keepAtMostDays": 400,
        "fields": [
          {
            "key": "from",
            "labelKey": "records.away.from",
            "provided": true
          },
          {
            "key": "to",
            "labelKey": "records.away.to",
            "provided": true
          }
        ]
      }
    ],
    "view": {
      "module": "./View",
      "titleKey": "view.title",
      "section": "board"
    },
    "settingsSchema": {
      "fields": [
        {
          "key": "heading",
          "labelKey": "settings.heading.label",
          "hintKey": "settings.heading.hint",
          "type": "text",
          "default": "Occupancy"
        },
        {
          "key": "showMembers",
          "labelKey": "settings.showMembers.label",
          "type": "boolean",
          "default": true
        },
        {
          "key": "rowLimit",
          "labelKey": "settings.rowLimit.label",
          "type": "number",
          "integer": true,
          "min": 1,
          "max": 200,
          "default": 25
        },
        {
          "key": "grouping",
          "labelKey": "settings.grouping.label",
          "type": "select",
          "default": "address",
          "options": [
            {
              "value": "address",
              "labelKey": "settings.grouping.address"
            },
            {
              "value": "floor",
              "labelKey": "settings.grouping.floor"
            }
          ]
        },
        {
          "key": "apiKey",
          "labelKey": "settings.apiKey.label",
          "hintKey": "settings.apiKey.hint",
          "type": "secret",
          "maxLength": 200
        }
      ]
    },
    "actions": [
      {
        "id": "summary",
        "capability": "addressBook:read",
        "effect": "read",
        "personalData": [],
        "surfaces": [
          "ui",
          "mcp"
        ]
      }
    ],
    "oauthProtectedResource": "mcp"
  },
  "devDependencies": {
    "@module-federation/vite": "1.23.4",
    "@nestjs/common": "12.1.0",
    "@openbrf/plugin-sdk": "file:../../packages/plugin-sdk",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "zod": "^4.6.2"
  }
}
