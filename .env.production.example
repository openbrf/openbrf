# Configuration for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Keep this file out of version control and back it up with the database and
# the data volume - unless it sets OPENBRF_ENCRYPTION_KEY, in which case it
# holds the key and is kept with the key's copies instead, out of the backups
# (docs/backup-and-restore.md). Generate each secret with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Any character is allowed in the two database passwords below. They end up
# inside PostgreSQL connection URLs, where :, /, @, ? and # are delimiters, and
# the entrypoint percent-encodes them as it builds those URLs.

# --- The public address -----------------------------------------------------
# The address members will use. Invitation and sign-in links are built from it,
# and the session cookie is issued for it. On a server this is the public
# https:// address, never localhost.
APP_URL="http://localhost:3000"

# Where the application listens on the host. Loopback by default: terminate
# TLS in a reverse proxy in front of it. Passkeys need a secure origin, which
# https, and only https, provides outside localhost.
APP_BIND_ADDRESS="127.0.0.1"
APP_PORT="3000"

# --- Database ---------------------------------------------------------------
# The schema owner. Runs migrations; never the application's connection.
POSTGRES_PASSWORD=""

# The application's own role, openbrf_app, which the entrypoint creates and
# constrains on every start. It owns nothing, so it cannot disable the triggers
# that keep the member register and the audit log append-only.
RUNTIME_DB_PASSWORD=""

# The alternative, for an operator who manages that role themselves: leave
# RUNTIME_DB_PASSWORD empty and give the whole connection here. The entrypoint
# then creates and constrains nothing, and uses this URL as written - so the
# password in it has to be percent-encoded already, and the role has to be
# constrained by hand (apps/api/prisma/sql/harden-runtime-role.sql is what the
# entrypoint would otherwise apply). Ordinarily this stays empty.
#
# One of these two has to be set. In production the instance refuses to start
# with neither, because the alternative is the application connecting as the
# schema owner.
DATABASE_URL_RUNTIME=""

# --- Authentication ---------------------------------------------------------
# Signs sessions and tokens. Changing it signs everyone out.
BETTER_AUTH_SECRET=""

# --- Encryption -------------------------------------------------------------
# Leave empty. The entrypoint generates a key into /data/keys on the first boot
# of an empty database and refuses to invent one on any later boot, because a
# fresh key cannot read fields written under the old one. Set this only when a
# hosting platform injects the key instead of mounting a volume; it must then
# be 32 bytes hex encoded.
OPENBRF_ENCRYPTION_KEY=""

# --- Plugins and themes -----------------------------------------------------
OPENBRF_PLUGINS_ENABLED="true"
# Leave empty: the instance reads the curated catalog built into it. An address
# written here is compared exactly, and any other spelling of the curated one
# is treated as an uncurated index and refused.
OPENBRF_CATALOG_URL=""
# Bearer token for an index that requires one. It is sent to the index, and to
# an artifact only when it is on the index's own origin, so a package hosted
# elsewhere is fetched without it. The curated catalog is public and needs none.
OPENBRF_CATALOG_TOKEN=""
# Installing from sources outside the curated catalog is a deliberate opt-out.
OPENBRF_UNCURATED_PLUGINS_ENABLED="false"

# --- Mail set where the instance runs ---------------------------------------
# Leave all of these empty and the board enters its own SMTP server in the setup
# wizard and the settings, which is the ordinary case. Set OPENBRF_MAIL_DRIVER to
# "smtp" or "http-api" to set the mail here instead: it is then used for every
# message, the settings show it and cannot change it, and an SMTP server the
# board stored earlier applies again once the driver is emptied. A variable of
# the other driver set beside the chosen one stops the instance at start
# (docs/deployment.md, "Mail").
OPENBRF_MAIL_DRIVER=""
# The sender's bare address, required by both drivers. It need not be on the
# association's own domain.
OPENBRF_MAIL_FROM_ADDRESS=""
# The display name. Empty uses the association's registered name.
OPENBRF_MAIL_FROM_NAME=""
# Where a reply goes when a message names nowhere of its own. Empty uses the
# board mailbox's address while one is configured.
OPENBRF_MAIL_REPLY_TO=""
# "smtp": the server, and a user and a password together or not at all. The
# port defaults to 465 with OPENBRF_SMTP_SECURE="true" (implicit TLS) and to 587
# without it.
OPENBRF_SMTP_HOST=""
OPENBRF_SMTP_PORT=""
OPENBRF_SMTP_SECURE=""
OPENBRF_SMTP_USER=""
OPENBRF_SMTP_PASSWORD=""
# "http-api": the service's base address (the instance posts to <this>/emails),
# its key, and the domain the service writes its own Message-ID under.
OPENBRF_MAIL_API_URL=""
OPENBRF_MAIL_API_KEY=""
OPENBRF_MAIL_API_MESSAGE_ID_DOMAIN=""

# An empty value above means "not set": the application treats a blank
# variable as absent rather than as a blank setting, so a value that does not
# apply to your instance can be left empty instead of deleted.
