{
  "name": "openbrf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "hooks:install": "git config core.hooksPath .githooks",
    "fixtures:build": "node scripts/build-fixture-catalog.mjs",
    "verify": "turbo run lint typecheck test build && pnpm format:check && pnpm --filter @openbrf/web theme:check && pnpm lint:coderabbit",
    "lint:coderabbit": "node scripts/validate-coderabbit-config.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "ajv": "^8.20.0",
    "eslint-plugin-i18next": "^6.1.5",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
