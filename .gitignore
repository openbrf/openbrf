# Dependencies and build output
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Generated Prisma client (regenerated by `pnpm db:generate`)
apps/api/src/generated/

# Local data volume: uploads, encryption keys, installed plugins and themes
.data/

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example

# Playwright output
playwright-report/
test-results/
e2e/.stack-state.json

# Images written by `pnpm screenshots`. They belong in a pull request
# description, not in the history: a binary per screen per theme per change
# would outweigh the source they illustrate within a release. Anchored to the
# root, because e2e/screenshots/ is the source that produces them.
/screenshots/

# Internal planning documents. Kept in the working tree so the implementing
# agent has them at hand, but never committed: they cite an internal decision
# log the public cannot see. The source of truth is the Obsidian vault.
docs/plans/

# Local tooling state (not part of the project)
.mcp.json
.impeccable/
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.log
