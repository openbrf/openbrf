# Dependencies and build output
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Generated Prisma client (regenerated by `pnpm db:generate`)
apps/api/src/generated/

# Local data volume: uploads, encryption keys, installed plugins and themes
.data/

# Built by `pnpm fixtures:build`. The fixture's source is committed; the packed
# tarball and the catalog that names it are not, because the catalog carries an
# absolute file: URL that is only correct on the machine that built it.
# (fixtures/example-plugin/dist/ is already covered by the dist/ rule above.)
fixtures/.artifacts/
fixtures/catalog/catalog.json

# Environment and secrets
.env
.env.*
!.env.example

# Internal planning documents. Kept in the working tree so the implementing
# agent has them at hand, but never committed: they cite an internal decision
# log the public cannot see. The source of truth is the Obsidian vault.
docs/plans/

# Local tooling state (not part of the project)
.mcp.json
.impeccable/
.claude/settings.local.json

# OS and editor noise
.DS_Store
Thumbs.db
*.log
