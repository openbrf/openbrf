// Open BRF core data model.
//
// One instance serves exactly one association (decision 28), so the core is
// tenancy-free: there is no associationId on every table.
//
// The model is split across two tiers that must never be conflated
// (decision 21, see docs/plans/phase-1.md section 4.2):
//
//   Statutory tier   MemberRegisterEntry, Transfer, LienNote and the
//                    confidential apartment register fields. Append-only,
//                    exempt from purging, retained at least 7 years
//                    (EFL 5 kap. via BRL 9 kap.).
//   Service tier     Accounts, contact data and operational residency data.
//                    Carries a computed purge date; the purge job itself is
//                    phase 2.
//
// Encrypted fields follow the CipherSweet construction from ADR 0002: a
// "<field>Cipher" column holds the ciphertext and a "<field>Index" column
// holds the blind index used for equality lookups. Name and postal address
// stay in plaintext because they are statutory member register content that
// must remain searchable and printable.
//
// Domain terms use the canonical English names from GLOSSARY.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7 no longer accepts a connection URL here: Migrate reads it from
// prisma.config.ts and the client receives a driver adapter at runtime.
datasource db {
  provider = "postgresql"
}

/// The association itself. Exactly one row per instance; the id is pinned to 1
/// by a check constraint added in the initial migration.
model Association {
  id                 Int     @id @default(1)
  name               String
  organizationNumber String?
  defaultLocale      String  @default("sv")

  /// Branding available on the free tier (decision 40).
  ///
  /// The logo is a reference to an uploaded file rather than a path: the bytes
  /// may sit on the data volume or in a bucket, and neither address is ever
  /// published, because the API streams the file from this instance's own
  /// origin. The second slot is the variant for dark surfaces - the
  /// application's top band is dark, and a mark drawn in dark ink disappears on
  /// it. When it is unset, the primary mark is rendered on a light plate.
  logoFileId     String?
  logo           MediaFile? @relation("AssociationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  logoDarkFileId String?
  logoDark       MediaFile? @relation("AssociationLogoDark", fields: [logoDarkFileId], references: [id], onDelete: SetNull)

  primaryColor String?

  /// Service-tier retention: days after move-out before service data is
  /// purged. Configurable per association; a fresh instance starts at 365 days
  /// (12 months), which the setup wizard shows. The purge job is phase 2.
  retentionDaysAfterMoveOut Int @default(365)

  /// Board-approved self-signup. Off by default: an instance holding a
  /// statutory register does not accept open registration.
  selfSignupEnabled Boolean @default(false)

  /// Whether the issue report form on the public website exists at all.
  ///
  /// On by default, unlike self-signup, and the difference is what the two
  /// forms produce. A sign-up request asks for an account on an instance
  /// holding a statutory register, so it stays shut until a board opens it. An
  /// issue report produces an issue and nothing else, and a cooperative's
  /// website is expected to let a neighbour report a broken door without an
  /// account. A board that would rather take issues only from its own
  /// residents turns this off, and the public form then does not exist - the
  /// anonymous audience is refused at the service, never merely hidden in the
  /// page.
  issueReportingPublic Boolean @default(true)

  /// The deadline the bylaws (stadgar) set for motions to the general meeting,
  /// as a recurring month and day.
  ///
  /// EFL 6 kap. 15 §, which BRL 9 kap. 14 § applies to a housing cooperative
  /// unchanged, gives a member the right to have an item taken up at a general
  /// meeting if they ask the board in writing in time for the notice, and adds
  /// that the request is to be made in the manner and within the time the
  /// bylaws determine where the bylaws say anything about it. So the deadline is
  /// the association's own clause and never the platform's: there is no default
  /// here, and null means the bylaws state none rather than that nobody has
  /// typed one in yet.
  ///
  /// A recurring month and day rather than an absolute date, because a bylaws
  /// clause is a standing rule. "Motions must reach the board by 31 January"
  /// holds every year, and a stored 2027-01-31 would be silently wrong for every
  /// season after the first - which is the worst shape for this failure to take,
  /// since it surfaces in the one month of the year the clause matters. Not a
  /// number of days before the meeting either, which is the other shape a clause
  /// takes: no meeting exists in this data model yet, so a window measured
  /// backwards from one would be a setting nothing could evaluate.
  ///
  /// Both columns are set or neither is, which SettingsService enforces. The day
  /// is taken as the clause writes it and clamped to the length of the month in
  /// the year it is resolved for, so a clause naming 29 February falls on the
  /// 28th in a year that has no 29th.
  motionDeadlineMonth Int?
  motionDeadlineDay   Int?

  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPasswordCipher String?
  smtpFromAddress    String?
  smtpSecure         Boolean @default(true)

  /// Which SMS driver this instance sends through, or null for none.
  ///
  /// A plain string rather than an enumerated type, and that is the point of an
  /// adapter: a driver written against another provider is a file and a branch
  /// in the selection, not a migration on this column. A value the running
  /// build does not recognise is treated as no provider at all, so an instance
  /// restored with a driver it no longer has records its text messages as
  /// unsent rather than guessing at one.
  ///
  /// Null by default. An association that has not signed up for SMS reaches its
  /// members by email, which is the ordinary case and costs nothing.
  smsDriver String?

  /// Where the HTTP gateway driver posts. Required by that driver and unused by
  /// any other: an instance naming a driver without the settings it needs is
  /// reported as unable to send, never as half configured.
  smsGatewayUrl String?

  /// Bearer credential for the gateway. Encrypted at rest like the SMTP
  /// password, unindexed for the same reason - it is read back by primary key
  /// and indexing a secret is pure downside.
  smsGatewayTokenCipher String?

  /// What a text message appears to come from, where the provider supports one.
  /// Sender identity is the one part of SMS that is not portable between
  /// routes, so it is stored beside the driver rather than assumed.
  smsSenderName String?

  /// Null means the built-in default theme (Porttavlan) is active.
  activeThemeId String?

  /// Set when the first-boot setup wizard completes.
  setupCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("association")
}

/// A street address, i.e. one entrance ("port"). The address book renders one
/// board per address.
model Address {
  id         String @id @default(cuid())
  street     String
  number     String
  postalCode String
  city       String

  /// Presentation order of the house tabs.
  sortOrder Int @default(0)

  apartments Apartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([street, number])
  @@map("address")
}

/// An apartment (lagenhet). Belongs to exactly one address.
model Apartment {
  id        String  @id @default(cuid())
  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// Lantmateriet numbering, e.g. "1101". Always rendered on the mono grid.
  number String

  /// Floor, derived from the apartment number but stored so the physical
  /// grouping on the board survives non-standard numbering.
  floor Int?

  /// Share of the association used for fee allocation (andelstal).
  participationShare Decimal? @db.Decimal(12, 8)

  /// Statutory tier, confidential: apartment register only (insats).
  initialShareCapital Decimal? @db.Decimal(14, 2)

  residencies           Residency[]
  lienNotes             LienNote[]
  transfers             Transfer[]
  memberRegisterEntries MemberRegisterEntry[]
  signupRequests        SignupRequest[]
  issues                Issue[]
  bookings              Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addressId, number])
  @@map("apartment")
}

/// A natural person. Needs no apartment, residency or membership: external
/// board members, admins and property managers are plain persons.
model Person {
  id String @id @default(cuid())

  /// Plaintext by design: statutory member register content that must stay
  /// searchable and printable.
  firstName String
  lastName  String

  postalStreet String?
  postalCode   String?
  postalCity   String?

  /// Alternative address used for persons with protected personal data.
  alternativePostalAddress String?

  emailCipher String?
  emailIndex  String?

  phoneCipher String?
  phoneIndex  String?

  personalIdentityNumberCipher String?
  personalIdentityNumberIndex  String?

  /// Protected personal data (skyddade personuppgifter): masked in every view,
  /// export and extract; each reveal is written to the audit log.
  protectedPersonalData Boolean @default(false)

  /// Locale used for this person's email and PDF extracts.
  preferredLocale String @default("sv")

  /// Null until the person activates an account.
  userAccount           User?
  residencies           Residency[]
  boardPositions        BoardPosition[]
  systemRoles           SystemRole[]
  invitations           Invitation[]
  memberRegisterEntries MemberRegisterEntry[]
  transfersFrom         Transfer[]            @relation("TransferFromPerson")
  transfersTo           Transfer[]            @relation("TransferToPerson")
  publicationConsents   PublicationConsent[]
  legalHolds            LegalHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailIndex])
  @@index([phoneIndex])
  @@index([personalIdentityNumberIndex])
  @@index([lastName, firstName])
  @@map("person")
}

enum ResidencyRole {
  /// Holds the tenant-ownership of the apartment (medlem). Occupancy is not
  /// required, and joint ownership is several concurrent MEMBER residencies.
  MEMBER

  /// Occupies the apartment without holding it (boende): partner, child from
  /// 13, or tenant.
  RESIDENT
}

/// The link between a person and an apartment over a period of time.
///
/// Membership is derived from this table: a person is a member while holding
/// at least one MEMBER residency that has not ended, and the member register
/// exit entry is written when the last one ends. "Moved out" is likewise
/// derived from movedOutOn, never stored as a flag on Person.
model Residency {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  role       ResidencyRole
  movedInOn  DateTime      @db.Date
  /// Null while the residency is current.
  movedOutOn DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apartmentId, movedOutOn])
  @@index([personId, movedOutOn])
  @@map("residency")
}

enum BoardPositionType {
  /// Ordforande.
  CHAIR
  /// Styrelseledamot.
  BOARD_MEMBER
  /// Suppleant.
  DEPUTY_BOARD_MEMBER
}

/// An elected position of trust. Drives the brass signs in the UI.
model BoardPosition {
  id       String            @id @default(cuid())
  personId String
  person   Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  position BoardPositionType

  electedOn DateTime  @db.Date
  /// Null while the person still holds the position.
  endedOn   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, endedOn])
  @@map("board_position")
}

enum SystemRoleType {
  /// Full access, including settings, plugins and themes.
  ADMIN

  /// External property manager (forvaltare). Issue handling only, never the
  /// address book. Schema and invitations only in phase 1: there is no
  /// property manager UI until the issues module exists.
  PROPERTY_MANAGER
}

/// A person-level capability grant, independent of residency or board seat.
model SystemRole {
  id       String         @id @default(cuid())
  personId String
  person   Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     SystemRoleType

  grantedAt DateTime @default(now())

  @@unique([personId, role])
  @@map("system_role")
}

/// An invitation to activate an account. Every account except the first admin
/// starts here.
model Invitation {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Hash of the invitation token. The token itself is only ever in the email.
  tokenHash String @unique

  expiresAt   DateTime
  acceptedAt  DateTime?
  /// Person who sent the invitation, when it was not the system.
  invitedById String?

  createdAt DateTime @default(now())

  @@index([personId])
  @@map("invitation")
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A self-signup request awaiting board approval.
///
/// The address and apartment are captured as free text because the form is
/// served before sign-in and must not enumerate the register. Matching against
/// a real apartment happens when the board reviews the request.
model SignupRequest {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  emailCipher String
  emailIndex  String
  phoneCipher String?

  claimedAddress         String
  claimedApartmentNumber String

  /// Set when the board matches the request to an apartment on approval.
  matchedApartmentId String?
  matchedApartment   Apartment? @relation(fields: [matchedApartmentId], references: [id], onDelete: SetNull)

  status       SignupRequestStatus @default(PENDING)
  decidedAt    DateTime?
  decidedById  String?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([emailIndex])
  @@map("signup_request")
}

enum MemberRegisterEventType {
  /// Membership granted (intrade).
  ENTRY
  /// Membership ended (uttrade).
  EXIT
  /// Correction of an earlier entry. Corrections are new rows, never updates.
  CORRECTION
}

/// The statutory member register (medlemsforteckning), EFL 5 kap. via
/// BRL 9 kap.
///
/// Append-only: the initial migration adds a BEFORE UPDATE OR DELETE trigger
/// that raises, and revokes UPDATE and DELETE from the runtime role. Rows are
/// retained at least 7 years and are exempt from purging. Never carries a
/// personal identity number: the extract from this register is public on
/// request.
model MemberRegisterEntry {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  eventType MemberRegisterEventType
  eventOn   DateTime                @db.Date

  /// Name and postal address as they stood at the time of the event, so the
  /// archive stays truthful when the person record later changes.
  recordedFirstName    String
  recordedLastName     String
  recordedPostalStreet String?
  recordedPostalCode   String?
  recordedPostalCity   String?

  /// Free-text note, e.g. the statutory ground for a correction.
  note String?

  /// Superseded row when eventType is CORRECTION.
  correctsEntryId String?

  createdAt DateTime @default(now())

  @@index([personId, eventOn])
  @@index([apartmentId, eventOn])
  @@map("member_register_entry")
}

/// Transfer of a tenant-ownership (overlatelse). Statutory tier.
model Transfer {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  /// Null for the first grant of a tenant-ownership (upplatelse).
  fromPersonId String?
  fromPerson   Person? @relation("TransferFromPerson", fields: [fromPersonId], references: [id], onDelete: Restrict)

  toPersonId String
  toPerson   Person @relation("TransferToPerson", fields: [toPersonId], references: [id], onDelete: Restrict)

  transferredOn DateTime @db.Date
  /// Purchase price, when recorded.
  price         Decimal? @db.Decimal(14, 2)

  /// Uploaded transfer agreement, relative to the uploads volume.
  agreementDocumentPath String?

  /// The board's own reference to the transfer agreement, e.g. a case number
  /// or where the paper copy is filed. The apartment register extract has to
  /// state a reference for every transfer (BRL 9 kap.), and today this is the
  /// only place one can live: nothing writes agreementDocumentPath yet. Kept
  /// once uploads exist, because a cooperative that files its agreements on
  /// paper still needs it.
  ///
  /// Nullable in Prisma but not free: a CHECK constraint requires one of this
  /// and agreementDocumentPath to hold at least one non-whitespace character,
  /// so an uploaded agreement satisfies the same requirement without a second
  /// migration. Prisma has no syntax for a CHECK, so it lives in
  /// 20260828170000_transfer_agreement_reference_required and is tightened to
  /// the full whitespace set in
  /// 20260828180000_transfer_agreement_reference_non_whitespace. Added NOT
  /// VALID because a row written before it has no reference to be found and
  /// inventing one would be a statement in a statutory register that nobody
  /// made.
  agreementReference String?

  createdAt DateTime @default(now())

  @@index([apartmentId, transferredOn])
  @@map("transfer")
}

/// A lien note in the apartment register (pantnotering). Statutory tier,
/// confidential: board and the holder of that apartment only.
model LienNote {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  creditor   String
  /// Statutory date of record (anteckningsdag).
  notedOn    DateTime  @db.Date
  releasedOn DateTime? @db.Date
  amount     Decimal?  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apartmentId, releasedOn])
  @@map("lien_note")
}

enum AuditAction {
  /// A masked field on a protected person was revealed.
  PROTECTED_DATA_REVEALED
  /// The protected personal data flag was set or cleared.
  PROTECTED_FLAG_CHANGED
  MEMBER_REGISTER_EXTRACT_GENERATED
  APARTMENT_REGISTER_EXTRACT_GENERATED
  /// A lien note was recorded against an apartment.
  APARTMENT_REGISTER_LIEN_NOTED
  /// A lien note was released. Its release date is a statutory date of record.
  APARTMENT_REGISTER_LIEN_RELEASED
  DATA_EXPORTED
  SYSTEM_ROLE_GRANTED
  SYSTEM_ROLE_REVOKED
  PLUGIN_INSTALLED
  PLUGIN_REMOVED
  THEME_INSTALLED
  THEME_ACTIVATED
  /// A file was uploaded, or removed from the instance.
  MEDIA_UPLOADED
  MEDIA_DELETED
  /// A file whose access is restricted to a capability was served. Files that
  /// are public, or readable by anyone signed in, are not logged: one entry per
  /// image request would bury the accesses the law requires to be recorded.
  MEDIA_ACCESSED
  /// An invitation to activate an account was created and mailed.
  INVITATION_SENT
  /// An invitation was used and the account it activates was created.
  INVITATION_ACCEPTED
  /// A self-signup request was approved, producing a person and a residency.
  SIGNUP_REQUEST_APPROVED
  /// A self-signup request was rejected.
  SIGNUP_REQUEST_REJECTED
  /// A theme was authored on this instance rather than installed from a
  /// catalog. Written beside THEME_INSTALLED, which records the admission
  /// every theme goes through however it was authored.
  THEME_COMPOSED
  /// A person's publication consent (publiceringssamtycke) was recorded for
  /// one scope.
  CONSENT_RECORDED
  /// A publication consent was withdrawn. The consent row stays: the record
  /// that it existed for a period is the evidence, and this entry is the act.
  CONSENT_WITHDRAWN
  /// A page on the association's website was published.
  PAGE_PUBLISHED
  /// A page's visibility changed between public and members only.
  PAGE_VISIBILITY_CHANGED
  /// A news item was published.
  NEWS_PUBLISHED
  /// A published news item was mailed to its recipients.
  NEWS_EMAILED
  /// A published news item was texted to its recipients.
  NEWS_TEXTED
  /// A legal hold was placed on a person's data, suspending the purge.
  LEGAL_HOLD_PLACED
  /// A legal hold was released, so the purge reaches that data again.
  LEGAL_HOLD_RELEASED
  /// Service-tier data past its retention date was purged. The statutory tier
  /// is exempt and is never reached by a purge.
  SERVICE_DATA_PURGED
  /// A person was recorded as elected to a position of trust on the board.
  BOARD_POSITION_ELECTED
  /// A board term was recorded as ended. The row stays where it is: a position
  /// of trust is a dated fact about who answered for the association and when,
  /// so ending one adds a date rather than removing the period it covered.
  BOARD_POSITION_ENDED
  /// A bookable resource was added to the association's catalogue.
  BOOKING_RESOURCE_CREATED
  /// A bookable resource was edited: its name, its description, its booking
  /// mechanics or its quota.
  BOOKING_RESOURCE_UPDATED
  /// A bookable resource was withdrawn from booking. The row stays, and so do
  /// the bookings made against it: they say what they were for only through
  /// it.
  BOOKING_RESOURCE_DEACTIVATED
  /// A resource was booked. The entry names the person who booked it as both
  /// the actor and the subject; the board never books on anybody's behalf.
  BOOKING_MADE
  /// A booking was cancelled, by the person who made it or by the board. The
  /// subject is whoever made it either way, so their access report shows a
  /// cancellation somebody else decided on.
  BOOKING_CANCELLED
  /// An event series was entered in the association's calendar.
  EVENT_SERIES_CREATED
  /// An event series was edited: what it says, when it runs, or how it
  /// repeats. The entry carries which fields moved and how many occurrences
  /// were added, moved and dropped by the change.
  EVENT_SERIES_UPDATED
  /// An event series was published, or taken down. Its audience travels with
  /// the entry, because publishing and deciding who it is for are one act.
  EVENT_SERIES_PUBLISHED
  /// One occurrence of a series was called off, leaving the rest of the series
  /// standing.
  EVENT_OCCURRENCE_CANCELLED
  /// A member submitted a motion to the general meeting. The member is both the
  /// actor and the subject: the right in EFL 6 kap. 15 § is theirs to exercise,
  /// and nobody submits on anybody's behalf.
  MOTION_SUBMITTED
  /// The board recorded that it had received a motion and would put it to a
  /// meeting. The subject stays the member who submitted it, so their access
  /// report shows what the board did with their item.
  MOTION_ACKNOWLEDGED
  /// A member took a motion back while it was still open. Actor and subject are
  /// the member, as at submission.
  MOTION_WITHDRAWN
}

/// Access log. Writes happen in the same transaction as the access they record.
model AuditLogEntry {
  id String @id @default(cuid())

  /// Null for actions taken by the system rather than a signed-in person.
  ///
  /// Deliberately a plain column and not a relation. A foreign key would have
  /// to carry a referential action, and every one of them rewrites this table:
  /// SetNull and SetDefault issue an UPDATE, Cascade a DELETE, and the
  /// append-only trigger rejects both, so deleting a person the log names
  /// would fail outright. Restrict would instead make the log veto erasure of
  /// any person it mentions. The log is evidence: it records the id that acted
  /// at the time, and that record stands even once the person is gone.
  actorPersonId String?

  action AuditAction

  /// The person acted upon. A plain column for the same reason as
  /// actorPersonId above.
  targetPersonId String?

  /// Free-form entity reference for non-person targets, e.g. a plugin id.
  targetKind String?
  targetId   String?

  /// Which fields were revealed, request context, and similar detail.
  context Json?

  createdAt DateTime @default(now())

  @@index([actorPersonId, createdAt])
  @@index([targetPersonId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log_entry")
}

/// How far an installation has got.
enum InstalledPluginStatus {
  /// The board has consented and the row is the desired state; the data
  /// volume does not carry the package yet.
  PENDING

  /// Present on the data volume and eligible to load at the next boot.
  INSTALLED

  /// The install job could not converge. lastError says why, and the row
  /// stays so the board can retry or withdraw it rather than having the
  /// failure disappear.
  FAILED
}

/// A plugin installed from the curated catalog.
///
/// The row is the DESIRED state and /data/plugins is reconciled to it, never
/// the other way round. That is what makes the install flow idempotent: the
/// job rebuilds the whole dependency set from these rows, so a crash at any
/// step converges on the next run rather than leaving the volume and the
/// database disagreeing. It is also why a removal deletes the row - what is
/// gone from here is gone from the volume at the next reconcile.
model InstalledPlugin {
  /// The plugin id from its manifest, e.g. "occupancy-summary".
  id          String @id
  packageName String
  version     String

  /// Where the archive came from. Kept so a reinstall on a volume-less
  /// deployment needs the catalog only for browsing, not for recovery.
  tarballUrl String @default("")

  /// sha512 of the verified tarball.
  checksum String

  enabled Boolean @default(true)

  status InstalledPluginStatus @default(PENDING)

  /// Why the last install attempt failed, for the admin screen. Cleared on
  /// the next successful reconcile.
  lastError String?

  /// Permissions and personal data categories as consented at install time.
  ///
  /// The loader compares the installed manifest against this snapshot and
  /// refuses a plugin that asks for more than the board agreed to, so a
  /// republished version cannot widen its own reach.
  consentedPermissions String[]
  declaredPersonalData String[]

  /// Values for the manifest's settingsSchema.
  settings Json?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_plugin")
}

/// A theme installed from the curated catalog. Themes are pure data
/// (decision 43), so installing one needs no restart.
///
/// The built-in default theme has no row here. It ships with the core, is
/// always present, always inheritable and cannot be uninstalled (decision 48),
/// so a row for it would be a row that must never be deleted. A null
/// Association.activeThemeId means the built-in theme is the active one.
model InstalledTheme {
  /// The theme id from its manifest, e.g. "example-theme".
  id      String @id
  /// The name a board member sees, from the manifest's displayName.
  name    String
  version String
  /// One sentence from the manifest saying what the theme is.
  description String?

  /// Token contract range the theme declares, e.g. "^1".
  contract String

  /// Theme this one inherits from; null inherits the built-in default.
  ///
  /// Deliberately not a foreign key: the built-in theme has no row to
  /// reference, so a constraint could not cover the common case, and half a
  /// constraint reads as a guarantee that is not there. Uninstall checks for
  /// dependants itself.
  extendsThemeId String?

  /// sha512 of the package, hex encoded, as the catalog stated it and as the
  /// download was verified against before anything was written to disk.
  checksum String
  /// Where the package was fetched from, so the audit entry can say what was
  /// installed and from where.
  sourceUrl String
  /// The catalog entry it came from, when it came from one.
  catalogId String?

  /// Token values exactly as the manifest stated them.
  ///
  /// Held alongside the resolved sets because inheritance has to be redone
  /// whenever an ancestor changes, and re-reading the package from the data
  /// volume to do that would make activation depend on the filesystem.
  declaredLightTokens Json
  declaredDarkTokens  Json

  /// The declared values merged down the inheritance chain and completed from
  /// the token contract's own fallbacks: what the interface actually renders.
  lightTokens  Json
  darkTokens   Json
  viewVariants Json?
  fonts        Json?
  logoPath     String?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([extendsThemeId])
  @@map("installed_theme")
}

// ---------------------------------------------------------------------------
// Authentication.
//
// These tables are owned by Better Auth: their shape comes from the library
// (verified against getAuthTables() for the configured plugins), not from our
// own design, so do not add domain fields here. The one exception is
// User.personId, which is the link between an account and the person it
// belongs to.
//
// Model names must stay exactly as they are: the Prisma adapter reaches the
// delegate as db[model], so model User must expose prisma.user, TwoFactor must
// expose prisma.twoFactor, and so on. The auth_ table prefix keeps them visibly
// separate from the domain tables.
// ---------------------------------------------------------------------------

/// A sign-in account. Exactly one per person, and a person may have none:
/// someone can sit in the register without ever activating an account.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Set when the person enrols TOTP.
  twoFactorEnabled Boolean? @default(false)

  /// The person this account belongs to. Required: an account with no person
  /// would be invisible to the address book and to a data subject access
  /// report.
  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]

  @@map("auth_user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for the credentials provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

/// TOTP enrolment. Includes the plugin's lockout counters, so repeated wrong
/// codes throttle rather than allowing an unlimited guessing loop.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(false)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_two_factor")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  /// Unique across the instance, not merely per user: sign-in looks a passkey
  /// up by this id alone and then trusts the row's userId, so a duplicate
  /// would let the stored row decide who is signed in.
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_passkey")
}

// ---------------------------------------------------------------------------
// Import.
// ---------------------------------------------------------------------------

enum ImportSourceFormat {
  CSV
  XLSX
}

enum ImportSessionStatus {
  /// Uploaded and parsed; a mapping is still being chosen or reviewed.
  MAPPING
  /// The board asked for the import and the job is waiting for a worker.
  QUEUED
  /// A worker is writing the register, chunk by chunk. `rowsDone` says how far
  /// it has got and is the point a restart resumes from.
  APPLYING
  /// Every row was processed. The session is kept only so the screen can show
  /// the outcome; nothing reads its rows again.
  APPLIED
  /// The apply stopped before the end. `failureReason` says why, and
  /// `rowsDone` says how much of the register was written before it stopped.
  FAILED
}

/// One uploaded member list, held between upload, column mapping, preview and
/// apply.
///
/// The rows are stored because the flow spans four requests and re-uploading
/// the file at each step would make the preview describe a file the apply step
/// never saw. They are stored **encrypted**: a cooperative's member list is the
/// densest personal data the instance ever handles - every name, address, email
/// and often every personal identity number in one blob - and this table has no
/// masking of its own. Service tier throughout: an upload is working material,
/// never a record, so it carries an expiry rather than a retention rule.
///
/// The row also carries the apply: what the board previewed, what it decided,
/// how far the job has got and what it has written. The register write is a
/// chunked background job (ADR 0002), so the state that survives a restart has
/// to be here rather than in a worker's memory.
model ImportSession {
  id String @id @default(cuid())

  /// Shown back to the board so it can tell two uploads apart.
  fileName String
  format   ImportSourceFormat

  /// The header row as read from the file, in file order. Plaintext: these are
  /// the uploader's own column titles, not the people in the rows below them.
  columns String[]

  /// The data rows as a JSON array of string arrays, encrypted as one value
  /// (ADR 0002). There is no blind index: nothing searches an upload.
  rowsCipher String
  rowCount   Int

  status ImportSessionStatus @default(MAPPING)

  /// The mapping the preview was taken with, one entry per column of the file,
  /// empty for a column that is not imported. The apply runs this rather than a
  /// mapping sent with it, so what is written is what the board looked at.
  mapping String[]

  /// Applied to rows with no role column, and to rows with no move-in column.
  /// The date is held as the calendar date it was chosen as, which is what the
  /// planner reads.
  defaultRole      ResidencyRole?
  defaultMovedInOn String?

  /// Rows the preview could not resolve to one person, as row number to the
  /// persons it could equally well have been. Written by the preview and read
  /// by the apply, which refuses to start while one of them has no decision.
  ambiguousRows Json?

  /// The board's answer for each ambiguous row: which person it is, that it is
  /// a new one, or that it is not imported.
  decisions Json?

  /// Rows whose writes are committed. The cursor a chunk claims and a restart
  /// resumes from: a chunk advances this in the same transaction as its writes,
  /// so a chunk is either wholly applied and counted or not applied at all.
  rowsDone Int @default(0)

  /// What the apply has written so far, accumulated per chunk.
  personsCreated               Int @default(0)
  personsUpdated               Int @default(0)
  residenciesCreated           Int @default(0)
  memberRegisterEntriesCreated Int @default(0)
  rowsSkipped                  Int @default(0)
  rowsWithProblems             Int @default(0)

  /// Why the apply stopped, when it stopped early. One of the import's own
  /// reason codes, so the screen translates it like any other failure.
  failureReason String?

  /// Person who uploaded the file. A plain column rather than a relation, for
  /// the same reason as AuditLogEntry.actorPersonId.
  createdById String?

  createdAt   DateTime  @default(now())
  previewedAt DateTime?
  /// When the first chunk began, and when the last one ended - whether it ended
  /// by finishing the file or by stopping.
  startedAt   DateTime?
  finishedAt  DateTime?
  /// After this the session is stale and is refused rather than applied.
  expiresAt   DateTime

  @@index([status, expiresAt])
  @@map("import_session")
}

// ---------------------------------------------------------------------------
// Media.
// ---------------------------------------------------------------------------

/// Who may fetch a stored file.
enum MediaVisibility {
  /// Anyone, with no session. The housing cooperative's logo has to be this:
  /// an email client renders it with no cookie to send, and the public website
  /// will serve it to visitors who have no account at all.
  PUBLIC
  /// Anyone signed in. A file that additionally names a required capability is
  /// narrowed to holders of it, and every serve of one is written to the audit
  /// log.
  INTERNAL
  /// A member of the housing cooperative, or a holder of the capability the
  /// file names.
  ///
  /// Narrower than INTERNAL rather than a variant of it. Membership is a
  /// residency role and not a capability, so it is asked of the principal
  /// instead of looked for in the column, and a file marked this way is not
  /// readable by every account that happens to be signed in - which is what
  /// the members' shelf of the document archive needs, since minutes of a
  /// general meeting name the members who spoke and how they voted.
  MEMBER
}

/// An uploaded file.
///
/// The bytes live in whichever storage driver the instance is configured for;
/// this row is the only index of them, and the only thing that decides who may
/// read them. The storage key is generated here and never derived from the name
/// the file arrived under.
model MediaFile {
  id String @id @default(cuid())

  /// Where the bytes are in the configured storage driver. Generated, never
  /// client-controlled.
  storageKey String @unique

  /// Identified from the bytes, not taken from the request. This is the type
  /// the file is served with, so trusting the declared one would let an upload
  /// choose how a browser interprets it.
  contentType String
  byteSize    Int
  /// SHA-256 of the stored bytes, hex encoded. Doubles as the entity tag on
  /// the serving path.
  checksum    String

  /// The name the file was uploaded under, kept for the download disposition
  /// and for the interface to show. Never used to build a storage key.
  fileName String

  /// Pixel dimensions, read out of the image header. Null for anything that is
  /// not an image.
  width  Int?
  height Int?

  /// Whether this image shows identifiable persons, as declared by whoever
  /// uploaded it. Required for an image and null for anything else.
  ///
  /// Recorded rather than acted on here. It is the input the publication
  /// guardrails need: a person may appear on a public page only with a recorded
  /// publication consent (publiceringssamtycke), and an image nobody has
  /// declared cannot be checked against that rule.
  showsIdentifiablePersons Boolean?

  visibility MediaVisibility @default(INTERNAL)

  /// A capability this file names, by its name in the capability model.
  ///
  /// What it does depends on the visibility, and the two are opposites on
  /// purpose. On an INTERNAL file it narrows: only holders may read it, and
  /// every serve is written to the audit log. On a MEMBER file it widens: it
  /// names who may read the file besides the members themselves, which is how
  /// the board and an administrator reach the members' shelf without holding a
  /// residency of their own. Null on a PUBLIC file, and on an INTERNAL one
  /// that anyone signed in may read.
  requiredCapability String?

  /// Who uploaded it.
  ///
  /// Deliberately a plain column and not a relation, for the reason the audit
  /// log gives: a referential action would either rewrite this row or veto
  /// erasure of the person it names. The record stands as it was written.
  uploadedByPersonId String?

  associationLogo     Association[] @relation("AssociationLogo")
  associationLogoDark Association[] @relation("AssociationLogoDark")
  issuePhotos         IssuePhoto[]
  document            Document?     @relation("DocumentFile")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("media_file")
}

// ---------------------------------------------------------------------------
// The public website.
// ---------------------------------------------------------------------------

/// Who may read a page.
enum PageVisibility {
  /// Anyone, with no session. This is what the housing cooperative publishes
  /// to the street: a visitor, a prospective buyer, a broker.
  PUBLIC
  /// Anyone signed in. A page nobody may read without an account is answered
  /// the same way a page that does not exist is, so the anonymous visitor
  /// cannot learn which of the two they asked for.
  MEMBER
}

/// A page on the association's own website.
///
/// Service tier: this is the cooperative's own writing about itself, not
/// register content. It carries no personal data by construction - the
/// rendering path reaches neither the registers nor the address book - and it
/// is therefore ordinary purgeable, editable, deletable data with no
/// append-only trigger and no retention floor.
///
/// The body is versioned JSON rather than markup: `{ version: 1, blocks: [...] }`.
/// Storing a block list rather than HTML is what lets the renderer decide what
/// a block becomes, so a page written today cannot carry a script or a
/// third-party embed into a future renderer. A block type the renderer does
/// not know is skipped rather than rendered, so a newer editor writing into an
/// older instance degrades to less content instead of to broken output.
model Page {
  id String @id @default(cuid())

  /// The path segment the page is served at, directly under the root. Unique
  /// because the URL is the identity: two pages claiming one address would
  /// make which of them a visitor sees an accident of ordering.
  slug String @unique

  title   String
  content Json

  visibility PageVisibility @default(PUBLIC)

  /// Whether the page is served at all. A page is written before it is meant
  /// to be read, and an unpublished one is answered exactly as a missing one.
  published   Boolean   @default(false)
  publishedAt DateTime?

  /// Where the page sits among its siblings. Also decides the home page: the
  /// lowest order among published public pages, oldest first on a tie. There
  /// is no isHome flag - the menu the board arranges is the ordering, and a
  /// second way to say which page is first would be a second way to disagree.
  sortOrder Int @default(0)

  /// The menu entries pointing at this page.
  ///
  /// Declared because a relation needs both of its sides, and it earns its
  /// place: the entries cascade with the page, so a page the board removes
  /// cannot leave the menu naming an address that answers with the not-found
  /// document.
  menuItems MenuItem[] @relation("PageMenuItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility, published, sortOrder])
  @@map("page")
}

// ---------------------------------------------------------------------------
// Publication consent.
// ---------------------------------------------------------------------------

/// What a person has agreed to appear as on something the association
/// publishes. One consent covers one of these and no more: agreeing to be
/// named in the board roster is not agreeing to be photographed.
enum ConsentScope {
  /// A photograph the person is identifiable in.
  PHOTO
  /// The person's name, on a page the association publishes.
  NAME_ON_SITE
  /// Name and position in the published board roster.
  BOARD_ROSTER
}

/// A person's publication consent (publiceringssamtycke).
///
/// The legal basis for putting personal data on a page the association
/// publishes (GDPR art. 6.1 a). The board records what the person told them,
/// the same way it records protected personal data, because the board is who
/// the person tells.
///
/// Granting and withdrawing are dated facts on one row rather than a boolean:
/// withdrawal sets withdrawnAt and never deletes the row, because the record
/// that consent existed between two dates is itself the evidence that what was
/// published while it stood was published lawfully. A person who grants,
/// withdraws and grants again therefore has several rows for one scope, and
/// the most recent one is the state that holds.
///
/// Service tier: this is not statutory register content, so there is no
/// append-only trigger and no retention floor. It is nonetheless never
/// rewritten in place except to set the withdrawal date.
model PublicationConsent {
  id String @id @default(cuid())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  scope ConsentScope

  /// When the person gave the consent, as the board recorded it.
  grantedAt DateTime

  /// Null while the consent stands.
  withdrawnAt DateTime?

  /// The board member who recorded the grant.
  ///
  /// Deliberately a plain column and not a relation, for the reason the audit
  /// log gives: a referential action would either rewrite this row or veto
  /// erasure of the person it names. Who withdrew a consent is in the audit
  /// log - this row is the fact, the log is the act.
  recordedByPersonId String?

  /// What the person said, in the board's own words. Describes the grant; a
  /// withdrawal's particulars belong in the audit entry that records it.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, scope, grantedAt])
  @@map("publication_consent")
}

// ---------------------------------------------------------------------------
// Issue reports (felanmalan).
// ---------------------------------------------------------------------------

/// Who an issue type is offered to.
///
/// The audience is a property of the TYPE rather than of a report, because it
/// decides what a person is even shown: a visitor with no account picks from
/// the non-member types, a resident from the member types, and the board
/// additionally from its own internal ones. The filter is applied on the server
/// for every principal - a client that asked for the whole catalogue would
/// otherwise learn the board's internal categories, which are the association's
/// own business.
enum IssueAudience {
  /// Offered on the public form: a passer-by, a neighbour, a contractor.
  NON_MEMBER
  /// Offered to a signed-in resident of the house.
  MEMBER
  /// Internal to whoever handles issues. Never offered to a reporter who does
  /// not already handle them.
  BOARD
}

/// Where an issue stands. Deliberately three states.
///
/// Comments, assignment and forwarding to a contractor are a later module: a
/// status a board cannot act on is a status that goes stale, and three is what
/// the triage queue can actually keep true.
enum IssueStatus {
  NEW
  IN_PROGRESS
  DONE
}

/// A category of issue, configured by the board.
///
/// Monolingual by decision 59: the name is the association's own writing about
/// its own building, stored as written and never translated. Only the interface
/// chrome around it is.
model IssueType {
  id String @id @default(cuid())

  name     String
  audience IssueAudience @default(MEMBER)

  /// Whether the type is offered for new reports. Deactivated rather than
  /// deleted once it has been used, so the issues already filed under it keep
  /// saying what they were about.
  active Boolean @default(true)

  /// Presentation order in the picker.
  sortOrder Int @default(0)

  issues Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, active, sortOrder])
  @@map("issue_type")
}

/// One reported issue.
///
/// Service tier, and among the most sensitive free text this platform holds:
/// the description is written by whoever reports the problem, and a report
/// about a leak in a bathroom or a neighbour's behaviour carries health data
/// and third-party personal data without anybody intending it to. That is why
/// the reporting form warns rather than refuses - refusing a description
/// because it looks like it holds personal data would refuse the reports the
/// module exists for - and why nothing here is published: an issue is readable
/// by its reporter and by whoever handles issues, and by nobody else.
///
/// Every reference out of this row is nullable and deletion-tolerant. Issue
/// data joins the service-tier retention story, so a purge has to be able to
/// remove a person, or an apartment to be corrected out of the register,
/// without either being vetoed by this table or rewriting what was reported.
model Issue {
  id String @id @default(cuid())

  typeId String
  type   IssueType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  status IssueStatus @default(NEW)

  /// The signed-in reporter, when there was one.
  ///
  /// Deliberately a plain column and not a relation, for the reason the audit
  /// log and the media file give: every referential action a foreign key can
  /// carry either rewrites this row or vetoes erasure of the person it names,
  /// and service-tier data has to be purgeable without the purge having to
  /// negotiate with the issue queue. Null for a report made through the public
  /// form, which has no account behind it.
  reporterPersonId String?

  /// Contact details for a report that came in without an account.
  ///
  /// Encrypted at rest exactly as a sign-up request's address is: a person who
  /// reports a broken door has told the association who they are, and that is
  /// personal data held for a service purpose rather than register content that
  /// has to stay searchable. The index exists so a second report from the same
  /// address can be recognised. Written by the public form; a signed-in report
  /// leaves all three null and is attributed by reporterPersonId instead.
  reporterNameCipher  String?
  reporterEmailCipher String?
  reporterEmailIndex  String?

  /// The apartment the issue concerns, when it concerns one.
  ///
  /// SetNull rather than Restrict: an apartment removed from the register must
  /// not be held hostage by a closed issue, and the free-text location below
  /// still says where the problem was.
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)

  /// Free text: "the bicycle room", "the lift in entrance 14". Not every issue
  /// is in an apartment, and a picker over the register would enumerate the
  /// building to whoever loaded the form.
  location String?

  description String

  photos IssuePhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reporterPersonId])
  @@index([reporterEmailIndex])
  @@map("issue")
}

/// A photograph attached to an issue.
///
/// A join rather than a column on the file, so an issue can carry several and
/// the media layer keeps knowing nothing about issues. Photos are attached by
/// signed-in reporters only: the public form takes text and never files, so the
/// platform exposes no unauthenticated upload surface at all.
model IssuePhoto {
  id String @id @default(cuid())

  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  /// Cascade: the row is an index of the file, and an index of bytes that are
  /// gone is worse than no index at all.
  fileId String
  file   MediaFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@unique([issueId, fileId])
  @@index([issueId, sortOrder])
  @@map("issue_photo")
}


// ---------------------------------------------------------------------------
// The document archive.
// ---------------------------------------------------------------------------

/// Who may read a document in the archive.
///
/// Three audiences and no more, because they are the three the association
/// actually distinguishes: what the board keeps to itself, what belongs to the
/// members (medlemmar), and what it publishes to the street. Reading is decided
/// by this value alone - there is no read capability - so a document's audience
/// is the whole of its access rule.
enum DocumentAudience {
  /// The board and an administrator. Every serve of one is written to the
  /// audit log, because the file it points at is narrowed by capability.
  BOARD
  /// Members of the association. A resident who is not a member does not see
  /// these: not every resident is a member (GLOSSARY: boende, medlem).
  MEMBER
  /// Anyone, with no session. What the cooperative publishes about itself -
  /// the bylaws, the annual report - and readable by a broker or a buyer.
  PUBLIC
}

/// A document in the association's archive.
///
/// Service tier: the bylaws, the minutes, the house rules and the annual
/// report are association records rather than personal data, so they carry no
/// append-only trigger, no retention floor and no purge date. The board that
/// uploaded a document may also remove it.
///
/// The bytes live in a MediaFile and are served by the media route, which is
/// the only route in the product that streams a stored file. The audience here
/// and the visibility there are kept in step by the service in one transaction:
/// the audience is what the archive shows, the visibility is what the serving
/// path enforces, and a document demoted from PUBLIC whose file stayed public
/// would still be fetchable at its own URL.
model Document {
  id String @id @default(cuid())

  /// What the board calls it, in the language the board wrote it in. Site
  /// content is monolingual (decision 59): stored as written, never
  /// translated.
  title String

  /// The binder it belongs in - "Stadgar", "Protokoll", "Årsredovisning".
  /// Free text with suggestions in the interface rather than an enum, because
  /// associations name their own binders and an enum would make the product
  /// argue with them about it.
  category String

  audience DocumentAudience @default(MEMBER)

  /// The bytes. One document per file: a file shared by two documents could
  /// not be given two audiences, and removing either document would decide
  /// for the other whether its bytes still exist.
  mediaFileId String    @unique
  mediaFile   MediaFile @relation("DocumentFile", fields: [mediaFileId], references: [id], onDelete: Cascade)

  /// Who put it in the archive.
  ///
  /// A plain column rather than a relation, for the reason the audit log and
  /// the media file both give: a referential action would either rewrite this
  /// row or veto erasure of the person it names.
  uploadedByPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, category])
  @@map("document")
}

// ---------------------------------------------------------------------------
// Retention: legal hold and the service-tier purge.
// ---------------------------------------------------------------------------

/// A legal hold (rattsligt bevarandekrav) on one person's service-tier data.
///
/// The purge is a promise the association makes to a person who has moved out,
/// and a legal hold is the one lawful reason to break it: a dispute, an
/// insurance claim or an authority's request means the association still needs
/// the data it would otherwise erase, and GDPR art. 17.3 recognises both
/// grounds: e where a legal claim is to be established or defended, b where a
/// legal obligation requires the data to be kept, which is what a binding
/// request from an authority creates. So the hold suspends the purge
/// rather than extending the retention policy - the policy is what the
/// association decided in general, the hold is why this one person is an
/// exception, and both have to be readable side by side.
///
/// The reason is required. A hold with no reason is indistinguishable from
/// data nobody got round to erasing, which is the state the purge exists to
/// end; requiring it is what makes the exception reviewable.
///
/// Released rather than deleted, and never rewritten except to set the release
/// date: the record that a hold stood between two dates is what explains why
/// the purge did not run for that person in that period. A person can be held
/// again afterwards, which is a new row.
///
/// Service tier: no append-only trigger and no retention floor. The audit log
/// carries the acts (LEGAL_HOLD_PLACED, LEGAL_HOLD_RELEASED) and is where the
/// history stands if this row is ever gone.
model LegalHold {
  id String @id @default(cuid())

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  /// Why the data is being kept. Free text, and deliberately not an enum: the
  /// grounds are the board's own, and a fixed list would make the product
  /// argue with a lawyer about them.
  reason String

  placedAt DateTime @default(now())

  /// Null while the hold stands.
  releasedAt DateTime?

  /// Why the hold was lifted, recorded on the same row as the placing.
  releaseReason String?

  /// The board member who placed the hold, and the one who released it.
  ///
  /// Plain columns rather than relations, for the reason the publication
  /// consent and the audit log both give: a referential action would either
  /// rewrite this row or veto erasure of the person it names.
  placedByPersonId   String?
  releasedByPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, releasedAt])
  @@map("legal_hold")
}

// ---------------------------------------------------------------------------
// The site menu.
// ---------------------------------------------------------------------------

/// What a menu item points at.
///
/// Three kinds and no more, because each one is a different question about
/// whether the item may be shown at all: a page has a visibility, a generated
/// page exists only while its feature does, and an address somewhere else is
/// always reachable and is the one thing on the website that leaves it.
enum MenuItemKind {
  /// One of the association's own pages. The page decides who sees the item.
  PAGE

  /// A page the product generates rather than the board writes - the news
  /// index, the broker information page, the account request form. Named by
  /// generatedKey, and silently left out while that feature is off or absent,
  /// so a menu survives a feature being switched off.
  GENERATED

  /// An address off this instance. The one external reference the website
  /// carries, and a navigation rather than a subresource: nothing is fetched
  /// from the other host while a page is being read.
  EXTERNAL
}

/// One entry in the menu the board arranges (meny).
///
/// The menu is also the ordering of the site: the first page entry in it is
/// the front page, which is why Page has no isHome flag. Two levels at most -
/// a top-level entry and the items hanging under it - because a third would be
/// a menu that needs a script to open and the website has none.
///
/// Which entries a visitor is shown follows from what each one points at
/// rather than from anything stored here. A member-only page's entry is not
/// rendered for a visitor with no session, so the menu cannot become the thing
/// that tells an anonymous reader the page exists - the same argument the
/// byte-identical not-found page rests on.
///
/// Service tier: the menu is the board's arrangement of its own website. It
/// carries no personal data, no append-only trigger and no retention floor.
model MenuItem {
  id String @id @default(cuid())

  /// What the menu says. Site content, so monolingual (decision 59): stored as
  /// the board wrote it and never translated. It defaults from the target's
  /// title when the item is created and is the board's to change after that,
  /// because a menu is written to fit the width of a menu.
  label String

  kind MenuItemKind

  /// The page this points at. Set for PAGE and for nothing else.
  ///
  /// Cascading, so removing a page removes its menu entries with it: an entry
  /// pointing at a page that no longer exists would be an item the renderer
  /// has to silently drop on every request forever.
  pageId String?
  page   Page?   @relation("PageMenuItems", fields: [pageId], references: [id], onDelete: Cascade)

  /// Which generated page. Set for GENERATED and for nothing else.
  ///
  /// A string rather than an enum: the set grows as the features that generate
  /// pages land, and a key the instance does not recognise is left out of the
  /// menu exactly like one whose feature is switched off. That is the same
  /// totality the page parser has, and it is what lets a menu row written by a
  /// newer version render less rather than wrong on an older one.
  generatedKey String?

  /// The address. Set for EXTERNAL and for nothing else, and https only.
  url String?

  /// The entry this one hangs under, or nothing for a top-level entry.
  ///
  /// One level of nesting is the whole rule, and it is enforced by the service
  /// rather than by the column: a check constraint cannot express "the parent
  /// has no parent of its own", and a trigger for a service-tier arrangement
  /// the board can fix in the interface would cost more than it protects.
  parentId String?
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemChildren")

  /// Where the entry sits among its siblings, top level and dropdown alike.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@map("menu_item")
}

/// A message somebody sent the board through the website's contact form.
///
/// Service tier, and the first thing a person with no account can write into
/// this instance besides a sign-up request. It is stored before anything is
/// sent: the board is notified by email through the job queue, and a mail
/// server that is down or unconfigured must never be able to lose a message
/// somebody wrote to their housing cooperative. The inbox in settings is
/// therefore the record, and the email is a notification about it.
///
/// The address is encrypted exactly as a sign-up request's is, and for the same
/// reason: it is personal data held for a service purpose rather than register
/// content, and the board reads it back when it answers. The name is stored as
/// written, like a sign-up request's, because it is what the sender typed
/// rather than something this platform asserts about a person. The index exists
/// so a second message from one address can be recognised as theirs.
///
/// The message itself is free text and is neither scanned nor refused. Somebody
/// writing to a board about a neighbour, a debt or their health writes it here,
/// and refusing the message would refuse the correspondence the form exists
/// for. Nothing here is ever published: the website writes into this table and
/// never reads from it.
model ContactSubmission {
  id String @id @default(cuid())

  /// What the sender called themselves. Optional: a message can be anonymous,
  /// and the address is what the board answers to.
  name String?

  emailCipher String
  emailIndex  String?

  message String

  /// Whether somebody on the board has dealt with it.
  ///
  /// A flag rather than a status, because there are two states a board can
  /// keep true about its own inbox. Anything richer - assignment, a reply
  /// thread - would be a correspondence module, and this is a form.
  handled   Boolean   @default(false)
  handledAt DateTime?

  /// Who marked it handled.
  ///
  /// A plain column rather than a relation, for the reason the audit log, the
  /// media file and the issue all give: a referential action would either
  /// rewrite this row or veto erasure of the person it names, and service-tier
  /// data has to be purgeable without negotiating with the board's inbox.
  handledByPersonId String?

  createdAt DateTime @default(now())

  @@index([handled, createdAt])
  @@index([emailIndex])
  @@map("contact_submission")
}

// ---------------------------------------------------------------------------
// News.
// ---------------------------------------------------------------------------

/// A news item on the association's website.
///
/// Service tier: what the board writes to the people who live in the house and
/// to whoever reads the website. It carries no register data and is deletable,
/// like a page.
///
/// The body is the same block list a page stores, read by the same parser, and
/// narrowed to prose: paragraphs and headings, never a picture and never a
/// block that reads something else out of the database. A news item is an
/// announcement rather than a page layout, and a data block on one would be a
/// second place where what the website discloses is decided.
///
/// Visibility is PageVisibility rather than an enum of its own. The question is
/// the same question - may somebody with no account read this - and a second
/// enum would be a second place for the two answers to drift apart.
model News {
  id String @id @default(cuid())

  /// The path segment under /nyheter. Unique for the same reason a page's is:
  /// the address is the identity.
  slug String @unique

  title   String
  content Json

  /// Members only unless the board says otherwise. A notice about the laundry
  /// room is written for the people who live in the house, and publishing one
  /// to the street is a deliberate second answer.
  visibility PageVisibility @default(MEMBER)

  published   Boolean   @default(false)
  publishedAt DateTime?

  /// When the mailing to the members was claimed, and never cleared.
  ///
  /// This column is the mailing's identity, not a progress flag. It is set by a
  /// conditional update that only matches while it is null, inside the same
  /// transaction that writes the delivery ledger and enqueues the job, so a
  /// news item is mailed at most once in its life. No edit and no republish
  /// writes it, which is what makes "never re-sent on an edit" a property of
  /// the schema rather than of anybody's care.
  emailQueuedAt DateTime?

  /// When the SMS mailing to the members was claimed, and never cleared.
  ///
  /// A second column rather than a second meaning for the first, because the
  /// two channels are claimed independently: a board that published by email
  /// alone can still decide to text the members afterwards, and one that has
  /// texted them must not be able to email them twice. Each column is written
  /// once, by its own conditional update, in the transaction that writes that
  /// channel's ledger rows and enqueues its job.
  smsQueuedAt DateTime?

  /// Who wrote it.
  ///
  /// A plain column rather than a relation, for the reason the audit log and
  /// the archived document both give: a referential action would either rewrite
  /// this row or veto erasure of the person it names.
  authorPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NewsDelivery[]

  @@index([published, visibility, publishedAt])
  @@map("news")
}

/// Which way one recipient's copy of a news mailing was sent.
///
/// A column on the ledger rather than a second ledger table. The two channels
/// are the same fact about the same act - the board addressed this person about
/// this news item - and keeping them in one table is what lets the claim, the
/// unique pair and the worker's discipline be written once instead of drifting
/// apart in two copies.
enum NewsDeliveryChannel {
  EMAIL
  SMS
}

/// How far one recipient's copy of a news mailing got.
enum NewsDeliveryStatus {
  /// Claimed at publish and not yet handed to a mail server.
  PENDING
  /// Accepted by the mail server. It is not a claim that anybody read it.
  SENT
  /// The mail server refused it, or this instance has none configured. The
  /// news item is published either way: only the mailing failed.
  FAILED
}

/// One recipient's copy of one news mailing.
///
/// The ledger is what makes "exactly once per recipient" mechanical. The
/// recipients are snapshotted into it inside the publish transaction, and the
/// pair (newsId, personId) is unique, so a second attempt at the same mailing
/// cannot add a second row for anybody. The worker then claims each row
/// conditionally - PENDING to SENT - before it hands the message to a mail
/// server, so a retried or duplicated job re-sends to nobody it already
/// reached.
///
/// The snapshot is taken at publish and never refreshed. A member who moves in
/// afterwards is not mailed old news, and somebody who moves out between the
/// publish and the worker still receives it: the ledger is the record of who
/// the board was writing to at the moment it published, which is the honest
/// reading of the act.
model NewsDelivery {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  /// The recipient. A plain column, like every other person reference outside
  /// the registers: a referential action here would either rewrite the ledger
  /// or veto erasure of the person it names. A recipient who is gone by the
  /// time the worker runs is recorded as undeliverable rather than mailed.
  personId String

  /// Which channel this row is the record of.
  ///
  /// Defaulted to EMAIL so the rows written before there was a second channel
  /// keep their meaning: every mailing there has ever been was an email.
  channel NewsDeliveryChannel @default(EMAIL)

  status        NewsDeliveryStatus @default(PENDING)
  /// Why it failed, as a code and never as the mail server's own words: a
  /// rejection quotes the address back, and the address is personal data.
  failureReason String?

  queuedAt DateTime  @default(now())
  sentAt   DateTime?

  /// One row per recipient per channel. The channel is part of the pair
  /// because a member reached both ways has been reached once each way - and
  /// because leaving it out would let the SMS snapshot collide with the email
  /// one and abort a publish that was doing exactly what it was asked to.
  @@unique([newsId, personId, channel])
  @@index([newsId, channel, status])
  @@map("news_delivery")
}

// The association's own facts, as a broker asks for them.
// ---------------------------------------------------------------------------

/// What a housing cooperative can say about itself to a broker or a buyer.
///
/// Service tier, and a table of its own rather than columns on Association:
/// that model carries what the instance runs on - the SMTP credentials, the
/// retention policy, the self-signup switch - and these are published prose the
/// board writes for the street. Keeping them apart means the query that renders
/// the public page selects from a table holding nothing operational.
///
/// One row, id 1, like Association. Every field is optional, because a board
/// fills this in over weeks rather than in one sitting and a half-answered page
/// is more use to a broker than none: an unrecorded fact is rendered as
/// nothing at all on the public page, never as an empty label.
///
/// Monolingual (decision 59). Free text is stored exactly as the board wrote
/// it and is never translated; the labels around it are chrome and are rendered
/// in the association's own default language, so a page does not mix a Swedish
/// answer under an English question.
///
/// Nothing here is derived from the statutory registers, and nothing here may
/// become so. The page these facts render is the association's own account of
/// itself; the per-apartment and per-person facts a transactional broker
/// extract (maklarbild) needs are a different product and out of core.
model AssociationFacts {
  id Int @id @default(1)

  /// The property's designation with Lantmateriet, e.g. "Eken 12".
  propertyDesignation String?

  /// The year the building was completed. An integer rather than free text so
  /// a page cannot show "cirka 1949?" as though the association were unsure of
  /// a fact a broker will read as certain.
  buildYear Int?

  /// Whether the association holds the land on a site leasehold (tomtratt)
  /// rather than owning it. Null is "not recorded" and is not the same answer
  /// as false: a broker reading "the association owns the land" needs the
  /// board to have said so.
  siteLeasehold Boolean?

  /// The terms of the leasehold, when there is one: the ground rent and when
  /// it is next renegotiated.
  siteLeaseholdNote String?

  /// How the fee (avgift) is set and when it was last changed.
  feePolicy String?

  /// What the fee covers - heating, water, broadband - and what it does not.
  feeIncludes String?

  /// The transfer fee (overlatelseavgift) and who pays it.
  transferFeePolicy String?

  /// The pledge fee (pantsattningsavgift) and who pays it.
  pledgeFeePolicy String?

  /// Whether the association accepts a legal person as a member. Null is "not
  /// recorded"; the note carries the conditions when there are any.
  legalPersonOwners Boolean?

  legalPersonOwnersNote String?

  /// Parking, garage places and how they are queued for.
  parking String?

  /// Storage: cellar and attic spaces, bicycle rooms, pram rooms.
  storage String?

  /// Renovations of note the association has carried out, and what is planned.
  renovations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("association_facts")
}

// ---------------------------------------------------------------------------
// Resource booking (bokning).
// ---------------------------------------------------------------------------

/// How a resource is booked, which is what decides what one booking is.
///
/// Three mechanics rather than a list of resource kinds. What a resource IS
/// says nothing the application needs: a sauna and a laundry room are booked
/// identically, and a common room let by the day has nothing in common with
/// either. What the application has to implement is the shape of a booking,
/// and that is what this enum names.
enum BookingResourceMode {
  /// Fixed-length slots inside one day, between an opening and a closing time:
  /// the laundry room (tvattstuga), the sauna (bastu). Carries slotMinutes,
  /// opensAtMinute and closesAtMinute.
  TIME_SLOTS

  /// One booking is one whole day: the common room (foreningslokal).
  WHOLE_DAY

  /// A check-in and a check-out date spanning nights: the guest apartment
  /// (gastlagenhet).
  DATE_RANGE
}

/// Where one booking stands.
enum BookingStatus {
  /// The booking holds its time. Exactly one booking per resource and start
  /// time may be in this state, which the database enforces - see Booking.
  BOOKED

  /// Withdrawn by whoever made it, or by the board on their behalf. The row
  /// stays and its time is free again.
  CANCELLED

  /// Reserved schema room, written by nothing in the core. See the Booking
  /// model comment.
  RELEASED
}

/// Something in the house that residents book: a laundry room, the common
/// room, the guest apartment, a sauna.
///
/// The board names its own, the way it names its issue types and the binders
/// in its archive. There is deliberately no kind enum: the association this is
/// built for books a laundry room, a common room, a guest apartment and a
/// sauna, and wants to add its own besides - a roof terrace, a workshop, a
/// trailer. A closed list would have been wrong on the day it shipped, and
/// every entry on it would have been a synonym for one of the three modes
/// below.
///
/// Service tier, and it holds no personal data at all. A booking does; this is
/// the association's account of what it offers, so it is outside every purge
/// scope and carries no purge date.
///
/// Deactivated, never deleted, for the reason IssueType gives: the bookings
/// already made against it say what they were for only through this row, and a
/// board tidying its catalogue must not make last winter's bookings
/// unreadable.
///
/// ## The two quotas
///
/// Both are nullable and each is set on its own, so one may be set, or both,
/// or neither. Null is unlimited.
///
/// `maxConcurrentBookings` bounds how many unstarted bookings one apartment
/// may hold at a time - what stops one household reserving every Saturday
/// until the spring. `maxBookingsPerWeek` bounds how many it may make within
/// one calendar week, Europe/Stockholm, which is a different question: a
/// household may hold one guest-apartment booking at a time and still do four
/// loads of laundry in a week. A sauna is often capped per week and not at all
/// concurrently, and a guest apartment the other way round, so neither limit
/// implies the other and neither is a default for the other.
model BookableResource {
  id String @id @default(cuid())

  /// What the board calls it: "Tvattstuga 1", "Foreningslokalen". Stored as
  /// the board wrote it and never translated - the association's own content
  /// is monolingual (decision 59).
  name String

  /// One sentence for whoever is booking: where it is, what is in it, what the
  /// house rules say about it.
  description String?

  mode BookingResourceMode

  /// TIME_SLOTS only, and required there: how long one slot is.
  slotMinutes Int?

  /// TIME_SLOTS only, and required there: when the day opens and when it
  /// closes, as minutes past midnight on the Europe/Stockholm wall clock, so
  /// 420 is 07:00 and 1260 is 21:00.
  ///
  /// Minutes rather than a DateTime because these are a time of day and not an
  /// instant. A laundry room opens at seven every morning, including the two
  /// mornings a year that are 23 and 25 hours long; an instant would pin the
  /// opening to the offset of whichever date it was stored on and move it by an
  /// hour on the far side of a daylight saving boundary.
  opensAtMinute  Int?
  closesAtMinute Int?

  /// Unstarted bookings one apartment may hold at once. Null is unlimited.
  maxConcurrentBookings Int?

  /// Bookings one apartment may make within one calendar week, Europe/
  /// Stockholm. Null is unlimited.
  maxBookingsPerWeek Int?

  /// When the board withdrew it from booking. Null while it is offered.
  deactivatedAt DateTime?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deactivatedAt, name])
  @@map("bookable_resource")
}

/// One booking of one resource.
///
/// Service tier and person-linked: it says who booked what, and when. That is
/// personal data held for a service purpose and for nothing else, so it is
/// purged on a date derived from `endsAt` rather than from a move-out - the
/// purpose of a laundry booking ends when the booking does, whether or not the
/// person who made it still lives here. The arithmetic is in
/// `src/bookings/booking-retention.ts` and the job that acts on it is
/// `BookingPurgeService`.
///
/// ## The double booking is refused by the database
///
/// A partial unique index over (resourceId, startsAt) WHERE status = 'BOOKED'
/// is what makes one slot one booking, and it is the whole of that guarantee:
/// two residents claiming the same laundry hour in the same instant are sorted
/// out by Postgres rather than by a read the application took a moment
/// earlier.
///
/// It has to be partial. A plain unique index over the pair would let a
/// cancelled booking keep its time for ever, so a period somebody changed their
/// mind about could never be booked by anyone again. Prisma cannot express a
/// WHERE clause on an index, so it is written by hand in
/// `migrations/20260902090000_bookings/migration.sql`, and there is
/// deliberately no `@@unique` here: the constraint Prisma is able to express is
/// not the constraint this table needs, and declaring it would be worse than
/// declaring nothing.
///
/// ## Reserved schema room
///
/// `RELEASED` and `startedAt` are columns, and columns are all they are.
/// Nothing in the core writes either one: there is no auto-release, no
/// check-in, no access-system webhook, no display mode and no job queue. They
/// exist so that the day something needs them, this table does not have to be
/// altered underneath live bookings.
model Booking {
  id String @id @default(cuid())

  /// Restrict rather than Cascade: a resource is deactivated and never
  /// deleted, and a delete that took its bookings with it would erase the
  /// record of who had booked what before anybody's retention date arrived.
  resourceId String
  resource   BookableResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  /// The apartment the booking is for, and what the quotas are counted
  /// against.
  ///
  /// SetNull rather than Restrict, exactly as Issue.apartmentId is: an
  /// apartment corrected out of the register must not be held hostage by a
  /// booking made against it last spring.
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)

  /// Who booked it.
  ///
  /// Deliberately a plain column and not a relation, for the reason the audit
  /// log and Issue.reporterPersonId give: every referential action a foreign
  /// key can carry either rewrites this row or vetoes erasure of the person it
  /// names, and service-tier data has to be purgeable without the purge having
  /// to negotiate with the booking calendar.
  bookedByPersonId String

  /// The booked period. Instants rather than dates even for the modes that are
  /// counted in days, so one comparison answers "has this ended" for all three
  /// - which is what the purge asks of the whole table at once.
  startsAt DateTime
  endsAt   DateTime

  status BookingStatus @default(BOOKED)

  /// Reserved schema room; see the model comment. Nothing writes it.
  startedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The calendar read: every booking on a resource, cancelled ones included,
  /// which the partial unique index above does not cover because it indexes
  /// only the live ones.
  @@index([resourceId, startsAt])
  @@index([bookedByPersonId, startsAt])
  @@index([apartmentId, startsAt])
  /// The purge scan: which bookings ended long enough ago.
  @@index([status, endsAt])
  @@map("booking")
}

// ---------------------------------------------------------------------------
// Event calendar (evenemangskalender).
// ---------------------------------------------------------------------------

/// How often a series repeats.
///
/// Three frequencies, because three are what a housing cooperative's calendar
/// is made of: a sauna evening every other week, a board meeting on the first
/// Monday of the month, a general meeting (foreningsstamma) once a year. There
/// is deliberately no DAILY - nothing an association arranges happens every day,
/// and a daily rule over the two-year horizon would write out seven hundred
/// rows for a mistake nobody meant to make.
enum EventRecurrenceFrequency {
  /// Every `recurrenceInterval` weeks, on the same weekday.
  WEEKLY

  /// Every `recurrenceInterval` months, on the same day of the month, clamped
  /// to the last day of a month that is too short - see Event.
  MONTHLY

  /// Every `recurrenceInterval` years, on the same date, with the 29th of
  /// February clamped to the 28th in a common year - see Event.
  ANNUAL
}

/// Something the association arranges, as a series: a cleaning day (stadag), a
/// board meeting, a sauna evening, the general meeting.
///
/// This row is the description of the series and never one date in it. The
/// dates are rows of their own - see EventOccurrence - because a sign-up
/// attaches to one of them and the capacity is counted per one of them, so an
/// occurrence needs an identity a foreign key can point at.
///
/// A series with no recurrence rule is a single event: one row here and exactly
/// one occurrence. There is no separate model, no flag and no second code path
/// for "single" - a one-off is the degenerate series, which is what stops the
/// two shapes drifting apart.
///
/// Service tier: the association's own account of what it is arranging. It
/// carries `authorPersonId`, which is a person reference and not personal data
/// held about that person, exactly as News.authorPersonId is - so this table is
/// outside every purge scope and carries no purge date. The sign-ups are the
/// personal data in this module and they live in their own table.
///
/// ## The time of day is a wall-clock fact
///
/// `firstOn`, `startsAtMinute` and `durationMinutes` state the series the way a
/// notice in the stairwell states it: a date, a time, and how long it runs.
/// Minutes past local midnight rather than an instant, for the reason
/// BookableResource.opensAtMinute gives - a cleaning day at ten in the morning
/// is at ten in the morning on the two Sundays a year that are 23 and 25 hours
/// long, and an instant would pin it to the offset of whichever date it was
/// stored on. Every occurrence's instants are derived from these three through
/// `instantAt`, and nothing in this module does arithmetic on an instant.
///
/// ## The recurrence rule, and why the columns are flat
///
/// Four nullable columns rather than a table of their own, on the precedent
/// BookableResource sets with its slot mechanics: a rule has exactly one row
/// per series and no identity of its own, and a second table would be a join
/// for every read of the calendar. They are set together or not at all, and the
/// API presents them as one nested object so that "there is a rule" and "there
/// is no rule" are one field rather than four.
///
/// A rule states its end, and states exactly one: a number of occurrences or a
/// last date. Neither is optional. The occurrences are written out when the
/// series is saved and nothing extends them afterwards, so a rule with no end
/// would not be an endless series - it would be one that stopped at the horizon
/// below for a reason no screen could explain.
///
/// Both of those are CHECK constraints as well as service rules -
/// `event_recurrence_states_one_end` in migration
/// 20260903115000_event_recurrence_constraints, alongside range checks on the
/// interval, the count, the time of day, the duration and the capacity. Prisma
/// has no syntax for a CHECK constraint, so they are not represented here.
/// They are in the database because the service is not the only writer that
/// reaches this table, and because a frequency without an end would otherwise be
/// answered by the API as a rule whose end is absent - which the wire contract
/// says cannot happen. The horizon is deliberately not among them: deciding
/// whether a rule reaches past it means generating the dates it names, which is
/// a program rather than a predicate, so it stays in
/// `checkRecurrenceSchedule`.
///
/// ## The horizon
///
/// A series reaches at most 731 days - two years - past its first occurrence,
/// and a rule reaching further is refused rather than truncated. 731 rather
/// than 730 so that a leap year inside the window does not shorten it: counting
/// 730 would let an annual series hold three dates in some years and two in
/// others, which is an asymmetry no board could predict.
///
/// Two years because the occurrences are rows: they cost storage, they are read
/// by every calendar query, and a board that wants a fourth year of sauna
/// evenings is a board that will still be here in two years to say so. It is
/// also the point past which a materialised calendar stops being useful - a
/// date five years out is a plan and not a booking, and the association's own
/// rules about what it arranges will have changed by then. An annual series
/// therefore holds three dates and a weekly one at most 105, which is the same
/// bound stated two ways.
///
/// ## Month ends and the 29th of February
///
/// A MONTHLY series on the 31st, and an ANNUAL one on the 29th of February, name
/// dates that do not exist in most months and most years. The rule is to clamp
/// to the last day of the target month: the 31st of January repeating monthly
/// falls on the 28th of February and then on the 31st of March, and the 29th of
/// February repeating annually falls on the 28th in a common year and on the
/// 29th again in the next leap year. Clamping is never cumulative - each
/// occurrence is computed from `firstOn` rather than from the occurrence before
/// it - which is what stops a series that touched February from spending the
/// rest of the year on the 28th.
model Event {
  id String @id @default(cuid())

  /// What the board calls it: "Stadag", "Styrelsemote", "Bastukvall". Stored as
  /// the board wrote it and never translated - the association's own content is
  /// monolingual (decision 59).
  title String

  /// What whoever is coming needs to know: what is being done, what to bring,
  /// where to meet.
  ///
  /// Plain text and not the versioned block JSON a page and a news item carry.
  /// An event's own description is a paragraph beside a date rather than a
  /// document, and it is rendered in a calendar entry rather than as a page of
  /// its own, so the block list would be a structure with nothing to put in it.
  description String?

  /// What the board sorts it under: "Stadag", "Motet", "Fest".
  ///
  /// Free text, on the precedent of the issue types and the archive's binders
  /// (parm): what an association arranges differs between associations, and a
  /// closed list would have been wrong on the day it shipped.
  category String?

  /// Where it happens: "Innergarden", "Foreningslokalen", "Zoom".
  location String?

  /// Members only unless the board says otherwise, exactly as a news item is.
  /// A cleaning day is arranged for the people who live in the house, and
  /// putting one on the street is a deliberate second answer rather than the
  /// default a slip lands on.
  visibility PageVisibility @default(MEMBER)

  published   Boolean   @default(false)
  publishedAt DateTime?

  /// Whether people may sign up (anmala sig) to the occurrences of this series.
  ///
  /// A series-level setting because it is a property of the thing being
  /// arranged - a cleaning day is signed up for and a notice about the water
  /// being off is not - while the sign-ups themselves attach to one occurrence.
  signupOpen Boolean @default(false)

  /// How many may sign up to ONE occurrence. Null is no limit.
  ///
  /// Per occurrence and not per series, which is the whole reason an occurrence
  /// is a row: twenty places at each of a year's cleaning days is twenty places
  /// twelve times over, not twenty for the year. Stated on the series because
  /// it is one decision about the thing being arranged, and read against each
  /// occurrence in turn.
  capacity Int?

  /// Who entered it.
  ///
  /// A plain column and not a relation, for the reason the audit log,
  /// Issue.reporterPersonId and News.authorPersonId all give: every referential
  /// action a foreign key can carry either rewrites this row when a person is
  /// erased or vetoes the erasure outright.
  authorPersonId String

  /// The local calendar date the first occurrence falls on.
  ///
  /// A date column, so it carries no time and no zone. Read back as midnight
  /// UTC by the client, which is why it is only ever compared with another
  /// calendar date and never with an instant - see `dateColumnOf` in
  /// `src/bookings/stockholm-calendar.ts`.
  firstOn DateTime @db.Date

  /// When it starts, as minutes past midnight on the Europe/Stockholm wall
  /// clock, so 600 is 10:00.
  startsAtMinute Int

  /// How long it runs, in wall-clock minutes.
  ///
  /// A duration rather than a closing time, because an event may run past
  /// midnight: a midsummer party from 20:00 for five hours ends at 01:00 the
  /// next day, and `instantAt` takes a minute past 1439 and rolls it into the
  /// following day for exactly this.
  ///
  /// Wall-clock minutes, so an event stated as 09:00 to 15:00 is 09:00 to 15:00
  /// on the 23-hour Sunday in March as well - and is five real hours long that
  /// day rather than six. That is what the notice says, so it is what this
  /// means.
  durationMinutes Int

  /// The recurrence rule, or four nulls for a single event. See the model
  /// comment: they are set together or not at all.
  recurrenceFrequency EventRecurrenceFrequency?

  /// Every how many weeks, months or years. At least one.
  recurrenceInterval Int?

  /// How many occurrences the series has in total, the first included. Set when
  /// the rule ends on a count, null when it ends on a date.
  recurrenceCount Int?

  /// The last local date an occurrence may fall on. Set when the rule ends on a
  /// date, null when it ends on a count.
  recurrenceUntil DateTime? @db.Date

  occurrences EventOccurrence[]
/// Where a motion stands. Three states, and it leaves the first exactly once.
///
/// A motion is closed with a date and never deleted: what a member put to the
/// meeting, and that the board received it, is the record the member is
/// entitled to be able to point at. Deleting a row would leave the association
/// with no answer to "I sent one in".
enum MotionStatus {
  /// With the board and not yet dealt with. Where every motion starts.
  SUBMITTED

  /// The board has recorded that it received the motion and will put it to a
  /// meeting. Not "approved": whether the meeting adopts the proposal is the
  /// meeting's decision and is minuted there, never here.
  ACKNOWLEDGED

  /// Taken back by the member who submitted it, while it was still open.
  WITHDRAWN
}

/// One motion (motion till stamman) put to the general meeting by a member.
///
/// ## Who may submit one
///
/// A member, and precisely a member. EFL 6 kap. 15 § - applied to a housing
/// cooperative by BRL 9 kap. 14 §, which excepts six of that chapter's rules and
/// not this one - gives the right to "en medlem", so a resident who is not a
/// tenant-owner has none of it: a partner, an adult child, a tenant. That is the
/// statute rather than a product choice, and it is why `motions:submit` is
/// derived from membership in `authorization/capabilities.ts` and re-checked
/// against the register by `MotionService.submit`.
///
/// The same paragraph withholds the right from a member who has been excluded
/// even though the membership has not yet ended. This platform records no
/// exclusion - the member register knows entry, exit and correction, and an
/// exclusion reaches it only as the exit it eventually becomes - so the check
/// cannot subtract that case and does not pretend to. A board handling a motion
/// from somebody it has excluded decides that on the facts it holds.
///
/// ## Service tier
///
/// The title and the body are the member's own writing and the person reference
/// is a plain column, so the purge can erase a motion without negotiating with
/// this table. The retention clock runs from the closing date rather than from a
/// move-out, for the reason `motion-retention.ts` gives, and an open motion is
/// not purged at all: the association is still processing it, so the purpose it
/// is held for has not ended.
///
/// ## No meeting
///
/// Deliberately no meetingId. Meetings are a later module, and a column
/// referencing a table that does not exist would be either a foreign key to
/// nothing or an identifier nothing could resolve. Which meeting a motion
/// reaches is answered when meetings exist; until then a motion is an item with
/// the board, which is what the statute makes it before a notice goes out.
model Motion {
  id String @id @default(cuid())

  /// What the member is proposing, in one line. The association's own content:
  /// stored as written and never translated (decision 59). Scanned for a
  /// personal identity number before it is stored, exactly as the body is and
  /// for the same reason: this is the line that goes into a notice verbatim.
  title String

  /// The proposal itself, and what a general meeting would vote on. Free text
  /// scanned for a personal identity number before it is stored - the one
  /// guardrail a member's own writing goes through here, applied to the title
  /// and to this together by MotionService.submit - because a motion is read out
  /// at a meeting and copied into a notice, and a personnummer in it is a
  /// disclosure the association cannot take back.
  body String

  /// The member who submitted it.
  ///
  /// A plain column and not a relation, for the reason Issue.reporterPersonId
  /// and Booking.bookedByPersonId are: every referential action a foreign key
  /// can carry either rewrites this row when a person is erased or vetoes the
  /// erasure outright, and service-tier data has to be purgeable without the
  /// purge having to negotiate with the motion queue.
  submittedByPersonId String

  submittedAt DateTime @default(now())

  status MotionStatus @default(SUBMITTED)

  /// When the motion stopped being open, whichever way it closed. Null while it
  /// is with the board.
  ///
  /// One date and not one per status, because a motion closes exactly once and
  /// there is no path back: the status says which close it was, and the purge
  /// needs a single column to compare a cutoff against rather than an OR across
  /// two.
  closedAt DateTime?

  /// Who closed it: the board member who acknowledged it, or the member who took
  /// it back. A plain column, for the reason submittedByPersonId is one.
  closedByPersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The published calendar read: which series a visitor or a member may see.
  @@index([published, visibility])
  @@map("event")
}

/// One date in a series: the cleaning day on the 18th of April, not "cleaning
/// days".
///
/// Materialised rather than generated on read, which is the difference between
/// this module and the booking module's slots. A slot is offered and claimed in
/// the same breath, so it can be computed from the resource's configuration
/// every time it is asked for. An occurrence is signed up for, and a sign-up is
/// a row pointing at the date it is for - so the date has to be a row with an
/// id. It is also what lets one occurrence be called off without touching the
/// rest of the series, which a computed calendar could not express.
///
/// The rows are rewritten when the series is edited, and only ahead of now:
/// occurrences that have already started are the record of what was arranged
/// and are left where they are. So a series whose time the board moved in June
/// has spring occurrences at the old time and autumn ones at the new, which is
/// what actually happened.
///
/// Instants, both of them, derived from the series' wall-clock fields through
/// `instantAt`. Nothing here is a date column: this is the pair every calendar
/// query compares against, and one comparison has to answer "has this happened"
/// for every series at once.
///
/// One occurrence per series per start instant, and in practice one per series
/// per local date - no rule this module offers can name the same date twice,
/// because every step is at least a week and the month and year steps are
/// computed from the first date rather than from each other. That invariant is
/// what lets an edit match the occurrences it already has against the ones the
/// new rule names by their local date.
model EventOccurrence {
  id String @id @default(cuid())

  /// Cascade rather than Restrict: an occurrence is not a record of anything on
  /// its own - it says nothing except through the series that names it - so a
  /// series the board removes takes its dates with it. What stops a series
  /// being removed at all is the refusal in the write service when somebody has
  /// signed up to one of its dates.
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime

  /// When the board called this one off. Null while it is going ahead.
  ///
  /// A dated close and never a delete, on the precedent of a withdrawn resource
  /// and a released legal hold: the occurrence was announced, people may have
  /// signed up to it, and "the cleaning day on the 18th was called off" is a
  /// different thing to say than "there was never one".
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One occurrence per series and start instant. Expressible as a constraint,
  /// so it is one: an edit that wrote a date twice would give a resident two
  /// identical entries to sign up to.
  @@unique([eventId, startsAt])
  /// The calendar read, which is by date across every series at once.
  @@index([startsAt])
  @@map("event_occurrence")
  /// The board's queue: open motions first, oldest first within a status.
  @@index([status, submittedAt])
  /// A member's own motions, and the DSAR section.
  @@index([submittedByPersonId, submittedAt])
  /// The purge scan: which motions closed long enough ago.
  @@index([closedAt])
  @@map("motion")
}
