// Open BRF core data model.
//
// One instance serves exactly one association (decision 28), so the core is
// tenancy-free: there is no associationId on every table.
//
// The model is split across two tiers that must never be conflated
// (decision 21, see docs/plans/phase-1.md section 4.2):
//
//   Statutory tier   MemberRegisterEntry, Transfer, LienNote and the
//                    confidential apartment register fields. Append-only,
//                    exempt from purging, retained at least 7 years
//                    (EFL 5 kap. via BRL 9 kap.).
//   Service tier     Accounts, contact data and operational residency data.
//                    Carries a computed purge date; the purge job itself is
//                    phase 2.
//
// Encrypted fields follow the CipherSweet construction from ADR 0002: a
// "<field>Cipher" column holds the ciphertext and a "<field>Index" column
// holds the blind index used for equality lookups. Name and postal address
// stay in plaintext because they are statutory member register content that
// must remain searchable and printable.
//
// Domain terms use the canonical English names from GLOSSARY.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7 no longer accepts a connection URL here: Migrate reads it from
// prisma.config.ts and the client receives a driver adapter at runtime.
datasource db {
  provider = "postgresql"
}

/// The association itself. Exactly one row per instance; the id is pinned to 1
/// by a check constraint added in the initial migration.
model Association {
  id                 Int     @id @default(1)
  name               String
  organizationNumber String?
  defaultLocale      String  @default("sv")

  /// Branding available on the free tier (decision 40).
  ///
  /// The logo is a reference to an uploaded file rather than a path: the bytes
  /// may sit on the data volume or in a bucket, and neither address is ever
  /// published, because the API streams the file from this instance's own
  /// origin. The second slot is the variant for dark surfaces - the
  /// application's top band is dark, and a mark drawn in dark ink disappears on
  /// it. When it is unset, the primary mark is rendered on a light plate.
  logoFileId     String?
  logo           MediaFile? @relation("AssociationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  logoDarkFileId String?
  logoDark       MediaFile? @relation("AssociationLogoDark", fields: [logoDarkFileId], references: [id], onDelete: SetNull)

  primaryColor String?

  /// Service-tier retention: days after move-out before service data is
  /// purged. Configurable per association; a fresh instance starts at 365 days
  /// (12 months), which the setup wizard shows. The purge job is phase 2.
  retentionDaysAfterMoveOut Int @default(365)

  /// Board-approved self-signup. Off by default: an instance holding a
  /// statutory register does not accept open registration.
  selfSignupEnabled Boolean @default(false)

  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPasswordCipher String?
  smtpFromAddress    String?
  smtpSecure         Boolean @default(true)

  /// Null means the built-in default theme (Porttavlan) is active.
  activeThemeId String?

  /// Set when the first-boot setup wizard completes.
  setupCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("association")
}

/// A street address, i.e. one entrance ("port"). The address book renders one
/// board per address.
model Address {
  id         String @id @default(cuid())
  street     String
  number     String
  postalCode String
  city       String

  /// Presentation order of the house tabs.
  sortOrder Int @default(0)

  apartments Apartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([street, number])
  @@map("address")
}

/// An apartment (lagenhet). Belongs to exactly one address.
model Apartment {
  id        String  @id @default(cuid())
  addressId String
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// Lantmateriet numbering, e.g. "1101". Always rendered on the mono grid.
  number String

  /// Floor, derived from the apartment number but stored so the physical
  /// grouping on the board survives non-standard numbering.
  floor Int?

  /// Share of the association used for fee allocation (andelstal).
  participationShare Decimal? @db.Decimal(12, 8)

  /// Statutory tier, confidential: apartment register only (insats).
  initialShareCapital Decimal? @db.Decimal(14, 2)

  residencies           Residency[]
  lienNotes             LienNote[]
  transfers             Transfer[]
  memberRegisterEntries MemberRegisterEntry[]
  signupRequests        SignupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([addressId, number])
  @@map("apartment")
}

/// A natural person. Needs no apartment, residency or membership: external
/// board members, admins and property managers are plain persons.
model Person {
  id String @id @default(cuid())

  /// Plaintext by design: statutory member register content that must stay
  /// searchable and printable.
  firstName String
  lastName  String

  postalStreet String?
  postalCode   String?
  postalCity   String?

  /// Alternative address used for persons with protected personal data.
  alternativePostalAddress String?

  emailCipher String?
  emailIndex  String?

  phoneCipher String?
  phoneIndex  String?

  personalIdentityNumberCipher String?
  personalIdentityNumberIndex  String?

  /// Protected personal data (skyddade personuppgifter): masked in every view,
  /// export and extract; each reveal is written to the audit log.
  protectedPersonalData Boolean @default(false)

  /// Locale used for this person's email and PDF extracts.
  preferredLocale String @default("sv")

  /// Null until the person activates an account.
  userAccount           User?
  residencies           Residency[]
  boardPositions        BoardPosition[]
  systemRoles           SystemRole[]
  invitations           Invitation[]
  memberRegisterEntries MemberRegisterEntry[]
  transfersFrom         Transfer[]            @relation("TransferFromPerson")
  transfersTo           Transfer[]            @relation("TransferToPerson")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailIndex])
  @@index([phoneIndex])
  @@index([personalIdentityNumberIndex])
  @@index([lastName, firstName])
  @@map("person")
}

enum ResidencyRole {
  /// Holds the tenant-ownership of the apartment (medlem). Occupancy is not
  /// required, and joint ownership is several concurrent MEMBER residencies.
  MEMBER

  /// Occupies the apartment without holding it (boende): partner, child from
  /// 13, or tenant.
  RESIDENT
}

/// The link between a person and an apartment over a period of time.
///
/// Membership is derived from this table: a person is a member while holding
/// at least one MEMBER residency that has not ended, and the member register
/// exit entry is written when the last one ends. "Moved out" is likewise
/// derived from movedOutOn, never stored as a flag on Person.
model Residency {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  role       ResidencyRole
  movedInOn  DateTime      @db.Date
  /// Null while the residency is current.
  movedOutOn DateTime?     @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apartmentId, movedOutOn])
  @@index([personId, movedOutOn])
  @@map("residency")
}

enum BoardPositionType {
  /// Ordforande.
  CHAIR
  /// Styrelseledamot.
  BOARD_MEMBER
  /// Suppleant.
  DEPUTY_BOARD_MEMBER
}

/// An elected position of trust. Drives the brass signs in the UI.
model BoardPosition {
  id       String            @id @default(cuid())
  personId String
  person   Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  position BoardPositionType

  electedOn DateTime  @db.Date
  /// Null while the person still holds the position.
  endedOn   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, endedOn])
  @@map("board_position")
}

enum SystemRoleType {
  /// Full access, including settings, plugins and themes.
  ADMIN

  /// External property manager (forvaltare). Issue handling only, never the
  /// address book. Schema and invitations only in phase 1: there is no
  /// property manager UI until the issues module exists.
  PROPERTY_MANAGER
}

/// A person-level capability grant, independent of residency or board seat.
model SystemRole {
  id       String         @id @default(cuid())
  personId String
  person   Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     SystemRoleType

  grantedAt DateTime @default(now())

  @@unique([personId, role])
  @@map("system_role")
}

/// An invitation to activate an account. Every account except the first admin
/// starts here.
model Invitation {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Hash of the invitation token. The token itself is only ever in the email.
  tokenHash String @unique

  expiresAt   DateTime
  acceptedAt  DateTime?
  /// Person who sent the invitation, when it was not the system.
  invitedById String?

  createdAt DateTime @default(now())

  @@index([personId])
  @@map("invitation")
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A self-signup request awaiting board approval.
///
/// The address and apartment are captured as free text because the form is
/// served before sign-in and must not enumerate the register. Matching against
/// a real apartment happens when the board reviews the request.
model SignupRequest {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  emailCipher String
  emailIndex  String
  phoneCipher String?

  claimedAddress         String
  claimedApartmentNumber String

  /// Set when the board matches the request to an apartment on approval.
  matchedApartmentId String?
  matchedApartment   Apartment? @relation(fields: [matchedApartmentId], references: [id], onDelete: SetNull)

  status       SignupRequestStatus @default(PENDING)
  decidedAt    DateTime?
  decidedById  String?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([emailIndex])
  @@map("signup_request")
}

enum MemberRegisterEventType {
  /// Membership granted (intrade).
  ENTRY
  /// Membership ended (uttrade).
  EXIT
  /// Correction of an earlier entry. Corrections are new rows, never updates.
  CORRECTION
}

/// The statutory member register (medlemsforteckning), EFL 5 kap. via
/// BRL 9 kap.
///
/// Append-only: the initial migration adds a BEFORE UPDATE OR DELETE trigger
/// that raises, and revokes UPDATE and DELETE from the runtime role. Rows are
/// retained at least 7 years and are exempt from purging. Never carries a
/// personal identity number: the extract from this register is public on
/// request.
model MemberRegisterEntry {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  eventType MemberRegisterEventType
  eventOn   DateTime                @db.Date

  /// Name and postal address as they stood at the time of the event, so the
  /// archive stays truthful when the person record later changes.
  recordedFirstName    String
  recordedLastName     String
  recordedPostalStreet String?
  recordedPostalCode   String?
  recordedPostalCity   String?

  /// Free-text note, e.g. the statutory ground for a correction.
  note String?

  /// Superseded row when eventType is CORRECTION.
  correctsEntryId String?

  createdAt DateTime @default(now())

  @@index([personId, eventOn])
  @@index([apartmentId, eventOn])
  @@map("member_register_entry")
}

/// Transfer of a tenant-ownership (overlatelse). Statutory tier.
model Transfer {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  /// Null for the first grant of a tenant-ownership (upplatelse).
  fromPersonId String?
  fromPerson   Person? @relation("TransferFromPerson", fields: [fromPersonId], references: [id], onDelete: Restrict)

  toPersonId String
  toPerson   Person @relation("TransferToPerson", fields: [toPersonId], references: [id], onDelete: Restrict)

  transferredOn DateTime @db.Date
  /// Purchase price, when recorded.
  price         Decimal? @db.Decimal(14, 2)

  /// Uploaded transfer agreement, relative to the uploads volume.
  agreementDocumentPath String?

  createdAt DateTime @default(now())

  @@index([apartmentId, transferredOn])
  @@map("transfer")
}

/// A lien note in the apartment register (pantnotering). Statutory tier,
/// confidential: board and the holder of that apartment only.
model LienNote {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  creditor   String
  /// Statutory date of record (anteckningsdag).
  notedOn    DateTime  @db.Date
  releasedOn DateTime? @db.Date
  amount     Decimal?  @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apartmentId, releasedOn])
  @@map("lien_note")
}

enum AuditAction {
  /// A masked field on a protected person was revealed.
  PROTECTED_DATA_REVEALED
  /// The protected personal data flag was set or cleared.
  PROTECTED_FLAG_CHANGED
  MEMBER_REGISTER_EXTRACT_GENERATED
  APARTMENT_REGISTER_EXTRACT_GENERATED
  DATA_EXPORTED
  SYSTEM_ROLE_GRANTED
  SYSTEM_ROLE_REVOKED
  PLUGIN_INSTALLED
  PLUGIN_REMOVED
  THEME_INSTALLED
  THEME_ACTIVATED
  /// A file was uploaded, or removed from the instance.
  MEDIA_UPLOADED
  MEDIA_DELETED
  /// A file whose access is restricted to a capability was served. Files that
  /// are public, or readable by anyone signed in, are not logged: one entry per
  /// image request would bury the accesses the law requires to be recorded.
  MEDIA_ACCESSED
}

/// Access log. Writes happen in the same transaction as the access they record.
model AuditLogEntry {
  id String @id @default(cuid())

  /// Null for actions taken by the system rather than a signed-in person.
  ///
  /// Deliberately a plain column and not a relation. A foreign key would have
  /// to carry a referential action, and every one of them rewrites this table:
  /// SetNull and SetDefault issue an UPDATE, Cascade a DELETE, and the
  /// append-only trigger rejects both, so deleting a person the log names
  /// would fail outright. Restrict would instead make the log veto erasure of
  /// any person it mentions. The log is evidence: it records the id that acted
  /// at the time, and that record stands even once the person is gone.
  actorPersonId String?

  action AuditAction

  /// The person acted upon. A plain column for the same reason as
  /// actorPersonId above.
  targetPersonId String?

  /// Free-form entity reference for non-person targets, e.g. a plugin id.
  targetKind String?
  targetId   String?

  /// Which fields were revealed, request context, and similar detail.
  context Json?

  createdAt DateTime @default(now())

  @@index([actorPersonId, createdAt])
  @@index([targetPersonId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log_entry")
}

/// A plugin installed from the curated catalog.
model InstalledPlugin {
  /// The plugin id from its manifest, e.g. "occupancy-summary".
  id          String @id
  packageName String
  version     String

  /// sha512 of the verified tarball.
  checksum String

  enabled Boolean @default(true)

  /// Permissions and personal data categories as consented at install time.
  consentedPermissions String[]
  declaredPersonalData String[]

  /// Values for the manifest's settingsSchema.
  settings Json?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_plugin")
}

/// A theme installed from the curated catalog. Themes are pure data
/// (decision 43), so installing one needs no restart.
model InstalledTheme {
  /// The theme id from its manifest, e.g. "example-theme".
  id      String @id
  name    String
  version String

  /// Token contract range the theme declares, e.g. "^1".
  contract String

  /// Theme this one inherits from; null inherits the built-in default.
  extendsThemeId String?

  checksum String

  /// Resolved token sets for both modes, and the declared view variants.
  lightTokens  Json
  darkTokens   Json
  viewVariants Json?
  fonts        Json?
  logoPath     String?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_theme")
}

// ---------------------------------------------------------------------------
// Authentication.
//
// These tables are owned by Better Auth: their shape comes from the library
// (verified against getAuthTables() for the configured plugins), not from our
// own design, so do not add domain fields here. The one exception is
// User.personId, which is the link between an account and the person it
// belongs to.
//
// Model names must stay exactly as they are: the Prisma adapter reaches the
// delegate as db[model], so model User must expose prisma.user, TwoFactor must
// expose prisma.twoFactor, and so on. The auth_ table prefix keeps them visibly
// separate from the domain tables.
// ---------------------------------------------------------------------------

/// A sign-in account. Exactly one per person, and a person may have none:
/// someone can sit in the register without ever activating an account.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Set when the person enrols TOTP.
  twoFactorEnabled Boolean? @default(false)

  /// The person this account belongs to. Required: an account with no person
  /// would be invisible to the address book and to a data subject access
  /// report.
  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  passkeys   Passkey[]

  @@map("auth_user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for the credentials provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

/// TOTP enrolment. Includes the plugin's lockout counters, so repeated wrong
/// codes throttle rather than allowing an unlimited guessing loop.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  verified                Boolean?  @default(false)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_two_factor")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  /// Unique across the instance, not merely per user: sign-in looks a passkey
  /// up by this id alone and then trusts the row's userId, so a duplicate
  /// would let the stored row decide who is signed in.
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_passkey")
}

/// Who may fetch a stored file.
enum MediaVisibility {
  /// Anyone, with no session. The housing cooperative's logo has to be this:
  /// an email client renders it with no cookie to send, and the public website
  /// will serve it to visitors who have no account at all.
  PUBLIC
  /// Anyone signed in. A file that additionally names a required capability is
  /// narrowed to holders of it, and every serve of one is written to the audit
  /// log.
  INTERNAL
}

/// An uploaded file.
///
/// The bytes live in whichever storage driver the instance is configured for;
/// this row is the only index of them, and the only thing that decides who may
/// read them. The storage key is generated here and never derived from the name
/// the file arrived under.
model MediaFile {
  id String @id @default(cuid())

  /// Where the bytes are in the configured storage driver. Generated, never
  /// client-controlled.
  storageKey String @unique

  /// Identified from the bytes, not taken from the request. This is the type
  /// the file is served with, so trusting the declared one would let an upload
  /// choose how a browser interprets it.
  contentType String
  byteSize    Int
  /// SHA-256 of the stored bytes, hex encoded. Doubles as the entity tag on
  /// the serving path.
  checksum    String

  /// The name the file was uploaded under, kept for the download disposition
  /// and for the interface to show. Never used to build a storage key.
  fileName String

  /// Pixel dimensions, read out of the image header. Null for anything that is
  /// not an image.
  width  Int?
  height Int?

  /// Whether this image shows identifiable persons, as declared by whoever
  /// uploaded it. Required for an image and null for anything else.
  ///
  /// Recorded rather than acted on here. It is the input the publication
  /// guardrails need: a person may appear on a public page only with a recorded
  /// publication consent (publiceringssamtycke), and an image nobody has
  /// declared cannot be checked against that rule.
  showsIdentifiablePersons Boolean?

  visibility MediaVisibility @default(INTERNAL)

  /// Narrows an INTERNAL file to holders of one capability, by its name in the
  /// capability model. Null leaves it readable by anyone signed in.
  requiredCapability String?

  /// Who uploaded it.
  ///
  /// Deliberately a plain column and not a relation, for the reason the audit
  /// log gives: a referential action would either rewrite this row or veto
  /// erasure of the person it names. The record stands as it was written.
  uploadedByPersonId String?

  associationLogo     Association[] @relation("AssociationLogo")
  associationLogoDark Association[] @relation("AssociationLogoDark")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("media_file")
}
