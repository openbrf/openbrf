{
  "name": "@openbrf/api",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "openbrf": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch & node --watch dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "vp lint .",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:int": "vp test run --config vitest.integration.config.mts",
    "db:jobs": "node scripts/install-job-schema.mjs",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed/main.js"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@openbrf/i18n": "workspace:*",
    "@openbrf/plugin-sdk": "workspace:*",
    "@openbrf/shared": "workspace:*",
    "@openbrf/theme-tools": "workspace:*",
    "@openbrf/tokens": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "ciphersweet-js": "2.0.6",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "i18next": "^26.4.4",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pg-boss": "12.37.1",
    "prisma": "7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "read-excel-file": "^9.3.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sodium-native": "5.1.0",
    "tar": "7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@prisma/driver-adapter-utils": "7.10.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite-plus": "catalog:"
  }
}
