# Open BRF instance configuration.
#
# Copy to .env for local development. One instance serves one association
# (decision 28), so there is no tenant configuration here.

# --- Database -------------------------------------------------------------
# Matches the db service in docker-compose.yml.
DATABASE_URL="postgresql://openbrf:openbrf@localhost:5432/openbrf"

# Migrations run as the schema owner; the application connects with a role
# that has no UPDATE or DELETE on the statutory register tables (ADR 0002 and
# the append-only guards in the initial migration). Leave unset in
# development to run everything as the owner.
# DATABASE_URL_RUNTIME="postgresql://openbrf_app:change-me@localhost:5432/openbrf"

# Connections the application's pool may hold, 1 to 50, ten by default. Where
# several instances share one server this comes out of its max_connections
# (docs/deployment.md, "Several instances on one database server"), which is
# also where RUNTIME_DB_ROLE, the name the container entrypoint gives the
# runtime role, is described.
# OPENBRF_DATABASE_POOL_SIZE=""

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Public base URL of this instance. Used in invitation and magic links.
APP_URL="http://localhost:5173"
# Reverse proxies whose X-Forwarded-For is believed, as addresses or CIDR
# ranges separated by commas. Empty, the rate limits count each request by the
# address it came from (docs/deployment.md, "Behind a reverse proxy").
# TRUSTED_PROXIES=""

# --- Encryption -----------------------------------------------------------
# Encryption key for fields and stored files (ADR 0002, ADR 0015), 32 bytes
# hex-encoded. When unset, the container entrypoint generates one into
# ${OPENBRF_DATA_DIR}/keys and uses that. Losing the key loses the data: copy it
# out once and keep it apart from every backup (docs/backup-and-restore.md).
# OPENBRF_ENCRYPTION_KEY=""

# --- Data volume ----------------------------------------------------------
# Holds uploads, keys, installed plugins and installed themes.
OPENBRF_DATA_DIR="./.data"

# --- File storage ---------------------------------------------------------
# Where uploaded files are kept: "local" writes into ${OPENBRF_DATA_DIR}/uploads
# and needs nothing else; "s3" writes into any S3-compatible bucket.
#
# The choice does not change how files reach a browser. This instance always
# streams them from its own origin, and never links or redirects to the storage
# endpoint - a redirect would disclose every visitor's IP address to the storage
# provider, which is the same reason the typefaces are self-hosted.
OPENBRF_STORAGE_DRIVER=local

# Required when OPENBRF_STORAGE_DRIVER=s3, ignored otherwise.
# OPENBRF_S3_ENDPOINT="https://s3.eu-north-1.amazonaws.com"
# OPENBRF_S3_BUCKET="openbrf"
# OPENBRF_S3_ACCESS_KEY_ID=""
# OPENBRF_S3_SECRET_ACCESS_KEY=""
# Signing region. Providers that do not use regions accept the default.
# OPENBRF_S3_REGION="us-east-1"
# Address the bucket in the path (https://host/bucket/key) rather than in the
# host name. Self-hosted servers generally need this; AWS S3 does not.
# OPENBRF_S3_FORCE_PATH_STYLE=false

# Largest upload accepted, in bytes. Enforced while the body is read, so a
# larger request is refused rather than buffered. Default 10 MiB. An upload is
# held in memory in full while it is identified, checksummed and stored, so
# this may not be set above 32 MiB (33554432); a larger value fails at boot.
# OPENBRF_MAX_UPLOAD_BYTES=10485760

# --- Mail -----------------------------------------------------------------
# Unset, the mail is the SMTP server entered in the setup wizard and the
# settings. "smtp" or "http-api" sets it here instead, wins over anything
# stored, and locks the settings (ADR 0024). Each driver needs its own
# variables below and refuses the other's.
# OPENBRF_MAIL_DRIVER=settings
# OPENBRF_MAIL_FROM_ADDRESS="utskick@example.org"
# Display name; unset, the association's registered name.
# OPENBRF_MAIL_FROM_NAME=""
# Reply-To for messages that name none; unset, the board mailbox's address.
# OPENBRF_MAIL_REPLY_TO=""
# "smtp":
# OPENBRF_SMTP_HOST="smtp.example.org"
# OPENBRF_SMTP_PORT=587
# OPENBRF_SMTP_SECURE=false
# STARTTLS is required before the sign-in unless the relay is on loopback.
# "false" allows a cleartext relay on a network you trust, such as a Postfix
# sidecar on the Compose network, and is logged as a warning at start.
# OPENBRF_SMTP_REQUIRE_TLS=
# OPENBRF_SMTP_USER=""
# OPENBRF_SMTP_PASSWORD=""
# "http-api": POST <url>/emails with a bearer key; the service's own Message-ID
# is <id>@<domain>.
# OPENBRF_MAIL_API_URL="https://api.example.org/v1"
# OPENBRF_MAIL_API_KEY=""
# OPENBRF_MAIL_API_MESSAGE_ID_DOMAIN="example.org"

# --- Authentication -------------------------------------------------------
# Signing secret for sessions and tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="dev-only-secret-change-me"
# Hosts a connected app may identify itself from by its metadata document URL,
# separated by commas. Empty, any public https host may.
# OPENBRF_OAUTH_CLIENT_METADATA_HOSTS=""

# --- The first administrator ----------------------------------------------
# Leave unset in development. A fresh database prints a setup link in the API
# log when the API starts, and the setup wizard asks for that link's code
# (ADR 0023). Set the SHA-256 digest of a token you minted yourself instead
# (base64url, 43 characters) to hand the link over; .env.production.example
# shows how to mint one.
# OPENBRF_SETUP_TOKEN_DIGEST=""

# --- Plugins and themes ---------------------------------------------------
OPENBRF_PLUGINS_ENABLED=true
# Empty reads the curated catalog built into the instance. A development
# instance may point this at a local index as a file: URL, which also needs
# OPENBRF_UNCURATED_PLUGINS_ENABLED=true.
OPENBRF_CATALOG_URL=""
# Bearer token for an index that requires one. It is sent to the index, and to
# an artifact only when it is on the index's own origin, so a package hosted
# elsewhere is fetched without it. The curated catalog is public and needs none.
# OPENBRF_CATALOG_TOKEN=""
# Installing from sources outside the curated catalog is a deliberate opt-out.
# Pointing OPENBRF_CATALOG_URL anywhere other than the curated index is
# refused unless this is true.
OPENBRF_UNCURATED_PLUGINS_ENABLED=false
# Reinstall plugins at boot when the data volume does not carry them. Off by
# default: on a normal deployment /data/plugins is a volume, and an empty one
# means something is wrong that a silent reinstall would hide. Turn it on for a
# deployment with no persistent volume, where the database is the only record
# of what should be running.
OPENBRF_PLUGINS_REINSTALL_ON_BOOT=false
