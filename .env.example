# Open BRF instance configuration.
#
# Copy to .env for local development. One instance serves one association
# (decision 28), so there is no tenant configuration here.

# --- Database -------------------------------------------------------------
# Matches the db service in docker-compose.yml.
DATABASE_URL="postgresql://openbrf:openbrf@localhost:5432/openbrf"

# Migrations run as the schema owner; the application connects with a role
# that has no UPDATE or DELETE on the statutory register tables (ADR 0002 and
# the append-only guards in the initial migration). Leave unset in
# development to run everything as the owner.
# DATABASE_URL_RUNTIME="postgresql://openbrf_app:change-me@localhost:5432/openbrf"

# --- HTTP -----------------------------------------------------------------
PORT=3000
# Public base URL of this instance. Used in invitation and magic links.
APP_URL="http://localhost:5173"

# --- Encryption -----------------------------------------------------------
# Field-level encryption key (ADR 0002), 32 bytes hex-encoded.
# When unset, the container entrypoint generates one into
# ${OPENBRF_DATA_DIR}/keys and uses that. Losing the key loses the data:
# back it up together with the database.
# OPENBRF_ENCRYPTION_KEY=""

# --- Data volume ----------------------------------------------------------
# Holds uploads, keys, installed plugins and installed themes.
OPENBRF_DATA_DIR="./.data"

# --- File storage ---------------------------------------------------------
# Where uploaded files are kept: "local" writes into ${OPENBRF_DATA_DIR}/uploads
# and needs nothing else; "s3" writes into any S3-compatible bucket.
#
# The choice does not change how files reach a browser. This instance always
# streams them from its own origin, and never links or redirects to the storage
# endpoint - a redirect would disclose every visitor's IP address to the storage
# provider, which is the same reason the typefaces are self-hosted.
OPENBRF_STORAGE_DRIVER=local

# Required when OPENBRF_STORAGE_DRIVER=s3, ignored otherwise.
# OPENBRF_S3_ENDPOINT="https://s3.eu-north-1.amazonaws.com"
# OPENBRF_S3_BUCKET="openbrf"
# OPENBRF_S3_ACCESS_KEY_ID=""
# OPENBRF_S3_SECRET_ACCESS_KEY=""
# Signing region. Providers that do not use regions accept the default.
# OPENBRF_S3_REGION="us-east-1"
# Address the bucket in the path (https://host/bucket/key) rather than in the
# host name. Self-hosted servers generally need this; AWS S3 does not.
# OPENBRF_S3_FORCE_PATH_STYLE=false

# Largest upload accepted, in bytes. Enforced while the body is read, so a
# larger request is refused rather than buffered. Default 10 MiB. An upload is
# held in memory in full while it is identified, checksummed and stored, so
# this may not be set above 32 MiB (33554432); a larger value fails at boot.
# OPENBRF_MAX_UPLOAD_BYTES=10485760

# --- Authentication -------------------------------------------------------
# Signing secret for sessions and tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="dev-only-secret-change-me"

# --- Plugins and themes ---------------------------------------------------
OPENBRF_PLUGINS_ENABLED=true
# Curated Apteo catalog is the only default source (decision 36). Pointing
# this at an uncurated index requires the opt-out flag below.
OPENBRF_CATALOG_URL="https://raw.githubusercontent.com/openbrf/catalog/main/catalog.json"
# A filesystem path is accepted here too, and package URLs inside the file are
# then resolved next to it. That is how the tests run the real install path -
# the same checksum verification and the same lint - with no network at all.
# Bearer token for the catalog and its release assets. Needed only while the
# catalog repository is private, before public launch.
# OPENBRF_CATALOG_TOKEN=""
# Installing from sources outside the curated catalog is a deliberate opt-out.
# Pointing OPENBRF_CATALOG_URL anywhere other than the curated index is
# refused unless this is true.
OPENBRF_UNCURATED_PLUGINS_ENABLED=false
# Reinstall plugins at boot when the data volume does not carry them. Off by
# default: on a normal deployment /data/plugins is a volume, and an empty one
# means something is wrong that a silent reinstall would hide. Turn it on for a
# deployment with no persistent volume, where the database is the only record
# of what should be running.
OPENBRF_PLUGINS_REINSTALL_ON_BOOT=false
