# Configuration for the screenshot stack. Committed on purpose: none of these
# values guards anything, the stack listens on loopback only, and its volumes
# are destroyed and recreated at the start of every run.
#
# A stack of its own, on ports of its own, so a capture and a test run can
# happen at the same time without sharing a container, a volume or a port. It
# also keeps the two instances' data apart, which matters more than the
# convenience: the end-to-end suite creates people carrying a personal identity
# number and a phone number in order to test masking, and the images this run
# produces are attached to public pull requests.

APP_URL=http://localhost:3011
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3011

E2E_DB_PORT=5443
E2E_MAILPIT_PORT=8126

# Hex, because these end up inside PostgreSQL connection URLs where a password
# containing :, /, @, ? or # would have to be percent-encoded.
POSTGRES_PASSWORD=5405000000000000000000000000000000000000000000000000000000000001
RUNTIME_DB_PASSWORD=5405000000000000000000000000000000000000000000000000000000000002
BETTER_AUTH_SECRET=5405000000000000000000000000000000000000000000000000000000000003

# Left empty so the entrypoint exercises the real first-boot path: it generates
# a key into the data volume, which is what a pilot's first start does.
OPENBRF_ENCRYPTION_KEY=

OPENBRF_PLUGINS_ENABLED=true
OPENBRF_CATALOG_URL=
OPENBRF_CATALOG_TOKEN=
OPENBRF_UNCURATED_PLUGINS_ENABLED=false
