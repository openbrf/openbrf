{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source is written with .ts specifiers and tsc rewrites them to .js on
    // emit. That keeps the source Node-resolvable while consumers import the
    // built output, so the flag never leaks into their tsconfig.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
