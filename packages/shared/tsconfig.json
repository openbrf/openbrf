{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source is written with .ts specifiers and tsc rewrites them to .js on
    // emit, the same arrangement as packages/tokens. Consumers import the built
    // output, so the flag never leaks into their tsconfig - and it has to not,
    // because the API type-checks whatever this package resolves to.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
