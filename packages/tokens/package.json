{
  "name": "@openbrf/tokens",
  "version": "1.1.0",
  "description": "The Open BRF design token contract, its default theme and the stylesheet built from it.",
  "keywords": [
    "openbrf",
    "brf",
    "housing-cooperative",
    "design-tokens",
    "theme",
    "css-variables"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "prepack": "node ../../scripts/copy-licence-files.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "LICENSE",
    "LICENSE-EXCEPTION.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/openbrf/openbrf/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbrf/openbrf.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/openbrf/openbrf/issues"
  }
}
