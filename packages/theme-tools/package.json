{
  "name": "@openbrf/theme-tools",
  "version": "0.0.0",
  "description": "The Open BRF theme package format: manifest, archive, lint and inheritance, as the core checks a theme at install time.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "prepack": "node ../../scripts/copy-licence-files.mjs"
  },
  "dependencies": {
    "@openbrf/tokens": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "LICENSE",
    "LICENSE-EXCEPTION.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbrf/openbrf.git",
    "directory": "packages/theme-tools"
  },
  "bugs": {
    "url": "https://github.com/openbrf/openbrf/issues"
  }
}
